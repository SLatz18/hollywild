            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "PARCEL FOOT TRIAL\nLong left flags:12\nCareful short:16\nRough hit:6 Coins",
                "Three left flags\nmark the safe\nroute.\nThe center is\nshort.",
                "Pass both center\nflags going down.\nTurning back ends\nyour shortcut run.",
                "Dodge the two\nstriped rough\npatches\nin the center\nlane.",
                "Only improvements\npay the\ndifference.\n16 Coins total\ncap."
              ],
              "avatarId": "",
              "minHeight": 4,
              "maxHeight": 7,
              "position": "bottom",
              "closeWhen": "key",
              "closeButton": "a"
