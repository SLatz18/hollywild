        "true": [
          {
            "id": "16593d49-6acc-41dc-a8b1-b9b918628b50",
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "HOLLYWILD ROUTES\nEast-west streets\nform one big loop.",
                "Frostwick > Candy\n> Brassworks >\nVelvet > Aurora",
                "North shortcuts:\nFrostwick-Brass\nCandy-Velvet",
                "Aurora north goes\nto Frostwick south.\nEvery road is open."
              ],
              "avatarId": "",
              "minHeight": 4,
              "maxHeight": 7,
              "position": "bottom",
              "closeWhen": "key",
              "closeButton": "a"
            }
          }
        ]
      }
    }
