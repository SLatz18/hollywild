                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "D-PAD: walk freely\nA: talk / confirm\nB: cancel menus\nSTART: pocket book\nSELECT: city",
                                        "routes",
                                        "Signs sell homes.\nSide doors let\nyou enter free.",
                                        "Want a challenge?\nGuide > Play has\nroutes to pipes\nand parcel trials.",
                                        "One job at a time.\nFinish it to run\ncrew production.\nKeep 4 scrap\nfor renovations."
                                      ],
