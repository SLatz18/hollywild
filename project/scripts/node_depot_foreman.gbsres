                      {
                        "id": "8b52dc60-7f82-4d25-a415-a47ed684dc55",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Foreman: I knew\nthat coat. Your\naunt carried soup\nin the left pocket\nand drawings in",
                            "the right.\nSometimes the\ndrawings smelled\nof leek. She left\na manifest here,",
                            "and a warning\nagainst people\nselling perfect\nwinters."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
