                                    "id": "191529db-5d64-4690-aef5-dc0abdc9e8c5",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "A Kettle Schedule",
                                        "The kettle card\ngives names, not\nhours. Whoever\ntakes the last cup",
                                        "fills it. Whoever\ncomes in cold gets\nthe first. The\nforeman calls",
                                        "this a scheduling\nsystem. He says\nits only serious\ndefect is Pip",
                                        "interpreting cold\nas an emotional\ncondition."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
