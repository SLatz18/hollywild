          {
            "id": "c00f56d3-4997-4b9d-a610-02007af4c05d",
            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "No clues yet for\nthis mission.\nFollow the next\nlead in START >\nStory."
              ],
              "avatarId": "",
              "minHeight": 4,
              "maxHeight": 7,
              "position": "bottom",
              "closeWhen": "key",
              "closeButton": "a"
            }
          }
        ],
