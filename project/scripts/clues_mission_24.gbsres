                  "args": {}
                },
                {
                  "id": "d8fc1b53-901d-4461-af1a-32a2e6fa3d39",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Pip reads his\nspeech: The city\nis warmer. We know\nwhy. We know what\nto check next.",
                      "Thank you for\ndoing your part.\nNib starts the\napplause. Slush\njoins with his",
                      "gloves on, then\nremoves them so it\nsounds properly\nsincere."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "41868b9f-19d8-4a0a-a6b9-8a9ea07ffa90",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
