        "true": [
          {
            "id": "93b00a00-73b8-4673-a9c7-241ba940186c",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "f52eda05-c5f3-4afb-adae-175671ccafc7",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "d5ec9c2f-a612-4efe-adad-e2f6b5195d33",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Rivet fits the\nchecked regulator,\nsigns its launch\nrecord, and starts\nthe turbine. The",
                      "needle rises to\nthe service mark\nand stays there. A\nbranch valve\nclicks, then",
                      "another. No one\ncheers until Dot\nconfirms that the\nreadings agree."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "c678bf92-02fd-47c4-a010-48e144700603",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "96489294-f53a-4439-a4ee-4b5b9fd4abc5",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
