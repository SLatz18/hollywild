                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Verify the correct\nnormal service\nsetting before the\nlaunch. A\ncelebration does",
                      "not change the\nengineering\nrecord."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
