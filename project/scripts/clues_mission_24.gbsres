      "children": {
        "true": [
          {
            "id": "dcb55c39-f08f-4f0c-a515-14140f8ee4a4",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "4d96c7a4-f82f-4da2-a1c3-4de5a9be9c93",
