            "children": {
              "true": [
                {
                  "id": "5485e45d-834b-40f4-ae27-a7965c93751f",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "eaa0cf48-496f-4977-a147-2250c7e48345",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Rivet: The\nmeasured safe\nservice limit is\nFOUR. SIX is a\nbrief test",
                      "ceiling, not a\nnormal setting.\nEIGHT is a damage\nwarning. We set\nthe regulator for",
                      "service, then\nverify the gauge.\nBigger is not a\nplan just because\nit fits on a sign."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "f5cfb858-3a04-443a-a4f1-cf3106288940",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
