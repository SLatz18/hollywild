                {
                  "id": "3e551312-e5f4-49d0-a44d-e08fc7dab4eb",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot checks the\nbucket record\nagainst the\nturbine plate.\nFOUR remains",
                      "the safe service\nlimit. She signs\nthe card and asks\nRivet to witness",
                      "it. Slush watches\nthe two signatures\nand asks where to\nput his. Dot",
                      "gives him the copy\nreceipt."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
