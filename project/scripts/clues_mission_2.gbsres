                {
                  "id": "0114734e-7e6e-401e-a420-3d92e16de178",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Manifest: The red\ncart carried\nbells. The blue\ncart carried",
                      "blankets. The\nyellow cart\ncarried a pressure\nvalve to\nBrassworks.",
                      "Silver S signed\nfor the yellow\ncart, then crossed\nout the",
                      "destination. The\ncarbon copy\nsurvived."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "535dda61-eefa-4289-afe5-082f3b557735",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
