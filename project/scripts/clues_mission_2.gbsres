                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The gate register\nneeds the color of\nthe cart that\ncarried the valve.\nWhich exit slip",
                      "should the clerk\nretrieve?"
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
