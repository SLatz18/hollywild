                {
                  "id": "f1243db8-692e-4d1a-acee-db0b3b03ef5f",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "3077d935-ad8f-4d5b-aa34-fdd24a80bf5d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Foreman: Sterling\nSlush paid the\ninspection bill.\nHe may own the\nbill, but that is",
                      "not the same as\nowning the valve.\nTell the archive\nclerk we still\nknow the",
                      "difference. Tell\nPip the kettle\ndoes not."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "c1724c1f-ea19-43eb-a9ce-34a179c3dd31",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
