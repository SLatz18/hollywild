        "true": [
          {
            "id": "d8faa812-756e-44fa-af1f-7b0cae230252",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "cc06a4a2-b6bb-4415-a9b7-5f9dcf94085c",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "9d95e53c-dd5f-4f1a-adae-4327fd3abb1c",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The tally must\nseparate a\nverified past\npayment from a\ndisputed charge.",
                      "Which amount can\nyou truthfully\nrecord as already\npaid by Slush?\nThis is not",
                      "permission to take\nmoney from your\nwallet. It is the\nfigure the foreman\nwill acknowledge,",
                      "and Slush will see\nwhether you\ncounted his\ncontribution\nhonestly."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "c710a1fc-9d73-4c64-acbb-6cc100105df4",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
