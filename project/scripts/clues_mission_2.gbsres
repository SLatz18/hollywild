                },
                {
                  "id": "b67b0811-6b1d-4605-a7f0-c4e1da946fd1",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Manifest: The red\ncart carried\nbells. The blue\ncart carried\nblankets. The",
                      "yellow cart\ncarried a pressure\nvalve to\nBrassworks. Silver\nS signed for the",
                      "yellow cart, then\ncrossed out the\ndestination. The\ncarbon copy\nsurvived."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "e0f0ede4-1138-4b42-a20b-ed0ba65c5625",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
