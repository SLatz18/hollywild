      "children": {
        "true": [
          {
            "id": "87bc2e0b-09f2-4d00-a372-cc84d8425e63",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "49ba3c6e-6f83-4061-a9d0-e50a1c031f9e",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "19da9273-8c04-455e-a5ad-92adcf8b3b84",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The tally must\nseparate a\nverified past\npayment from a\ndisputed",
                      "charge. Which\namount can you\ntruthfully record\nas already paid by",
                      "Slush? This is not\npermission to take\nmoney from your\nwallet. It is",
                      "the figure the\nforeman will\nacknowledge, and\nSlush will see\nwhether",
                      "you counted his\ncontribution\nhonestly."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "d35ac32a-6eea-4601-ac2f-f9abbd23d90c",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
