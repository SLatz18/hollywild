        "true": [
          {
            "id": "4bde2ff1-c755-421a-a24d-b5e9313682ec",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "8a71d991-baa5-46f3-aac0-9f70e966599c",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "569df71c-796c-4012-aa1c-e8f91e6ae1bd",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Foreman: Sterling\nSlush paid the\ninspection bill.\nHe may own the",
                      "bill, but that is\nnot the same as\nowning the valve.\nTell the archive",
                      "clerk we still\nknow the\ndifference. Tell\nPip the kettle\ndoes not."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "435bdab8-152d-4fa4-ad2f-2dc7e0f87051",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
