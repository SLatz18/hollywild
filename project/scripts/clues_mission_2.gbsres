      "children": {
        "true": [
          {
            "id": "c49a0e6e-d147-4187-ab35-e19432c07403",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "b0d096f0-4673-466b-abea-51f4a200f20a",
