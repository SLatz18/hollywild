                                    "id": "3073991b-2e2a-4e11-a2a2-fe352945d287",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "The city stays\nopen. Explore,\nbuild, and visit\nyour neighbors."
                                      ],
