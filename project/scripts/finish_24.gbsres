                              "children": {
                                "true": [
                                  {
                                    "id": "446e5380-e62e-4832-a63d-b21875f8896b",
                                    "command": "EVENT_GROUP",
                                    "args": {},
                                    "children": {
                                      "true": [
                                        {
                                          "id": "81522f13-aca5-4a16-a232-4730c29f520b",
