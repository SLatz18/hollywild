                            {
                              "id": "36362748-3c6a-4f17-acd9-a92e3325ccd4",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The city is still\nyours to explore.\nThere are jobs to\ntake and old",
                                  "properties that\ncould become\nsomething\nwonderful. Slush\nkeeps his",
                                  "silver umbrella;\nDot keeps the\npencil. Pip leaves\nthe desk lamp on,",
                                  "beside a blank\nfault form and\nenough space for\nthe next useful\nidea."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
                            },
