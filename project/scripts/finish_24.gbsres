                              "children": {
                                "true": [
                                  {
                                    "id": "31fe74de-5c1e-4451-ac8f-4e6c7bbf1ccc",
                                    "command": "EVENT_GROUP",
                                    "args": {},
                                    "children": {
                                      "true": [
                                        {
