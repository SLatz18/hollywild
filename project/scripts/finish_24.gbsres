                                          "type": "number",
                                          "value": 2
                                        }
                                      }
                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "5d673fac-6d75-472b-ad53-0deddac3a89c",
                                          "command": "EVENT_GROUP",
                                          "args": {},
                                          "children": {
                                            "true": [
                                              {
                                                "id": "0ce229ae-6a53-4026-a944-366d5389ad36",
                                                "command": "EVENT_HIDE_SPRITES",
                                                "args": {}
                                              },
                                              {
                                                "id": "7f6af3f0-87be-4896-aab8-3cfcabb1919d",
                                                "command": "EVENT_TEXT",
                                                "args": {
                                                  "text": [
                                                    "The first upgrades\nwarm the repair\nshops and the\ntraining benches.",
                                                    "The new wage board\nincludes paid\nlearning time and\nnames the person",
                                                    "who checks each\ntask. Rivet takes\ndown a heroic\nposter to make\nroom",
                                                    "for it. Moxie\ndelivers a\nreplacement gear\non a route with a\nreal",
                                                    "backup, then\nspends her break\nteaching a new\ncourier the\naddress",
                                                    "cards. Dot leads\nthe shutdown test\nwithout asking\nsomeone else to",
                                                    "read her results\naloud. Slush opens\nhis yard for tool\ntraining and",
                                                    "discovers that\npeople respect a\nuseful landlord\neven when his name",
                                                    "is not on the\ngate. Nib\nadvertises the\nwork honestly:\npaid,",
                                                    "practical,\noccasionally oily.\nThe machines have\nnot solved every",
                                                    "problem. They have\nmade repair work\npossible, and the\nwages help",
                                                    "people choose what\ncomes next. The\ncity remains open\nfor your own",
                                                    "jobs, properties,\nand plans. At\ndusk, a shop\nwhistle sounds\nonce,",
                                                    "exactly when the\nposted shift ends."
                                                  ],
                                                  "avatarId": "",
                                                  "minHeight": 4,
                                                  "maxHeight": 7,
                                                  "position": "bottom",
                                                  "closeWhen": "key",
                                                  "closeButton": "a"
                                                }
                                              },
                                              {
                                                "id": "b8b43179-c565-4af2-ae2d-67e7a57a699e",
                                                "command": "EVENT_SHOW_SPRITES",
                                                "args": {}
                                              }
                                            ]
                                          }
                                        }
                                      ],
                                      "false": [
                                        {
                                          "id": "add765f7-ab11-43b6-ab3c-4ef14c1f7188",
                                          "command": "EVENT_IF",
                                          "args": {
                                            "condition": {
                                              "type": "eq",
                                              "valueA": {
                                                "type": "variable",
                                                "value": "49"
                                              },
                                              "valueB": {
                                                "type": "number",
                                                "value": 3
                                              }
                                            }
                                          },
                                          "children": {
                                            "true": [
                                              {
                                                "id": "15fd3be9-de23-4fa5-a932-2307d39000f4",
                                                "command": "EVENT_GROUP",
                                                "args": {},
                                                "children": {
                                                  "true": [
                                                    {
                                                      "id": "552e70f4-af75-4124-a535-e15fba8873d5",
                                                      "command": "EVENT_HIDE_SPRITES",
                                                      "args": {}
                                                    },
                                                    {
                                                      "id": "400421bc-1ddf-4011-a509-4f8833a5a92f",
                                                      "command": "EVENT_TEXT",
                                                      "args": {
                                                        "text": [
                                                          "The first upgrades\nwarm the shared\nhalls, public\nkitchens, and",
                                                          "meeting rooms. Nib\nposts the opening\nhours beside the\ncleaning",
                                                          "duties in print\nequally large. The\nfirst gathering is\na soup",
                                                          "exchange. Nobody\ncan agree which\nsoup won, so the\nclerk suggests",
                                                          "eating the\nevidence. Moxie\nadds the halls to\na written courier\nrota.",
                                                          "Rivet teaches a\nsmall repair class\nat a table\nprotected by an",
                                                          "extremely ugly\ncloth. Dot\nexplains the\nsignal map to\nresidents who",
                                                          "now know whom to\nask when a reply\nfails. Slush lends\nthe lodge hall",
                                                          "on the same posted\nterms as everyone\nelse. He still\ncarries his",
                                                          "silver umbrella,\nbut has learned to\nleave it in the\ncommon rack. You",
                                                          "can return to free\nexploration,\noptional jobs, and\nproperties of",
                                                          "your own. The\nnetwork has not\nmade everyone\nagree. It has\ngiven them",
                                                          "somewhere warm to\nwork out the\ndisagreement, with\nspare chairs and",
                                                          "an honest plan for\nthe morning."
                                                        ],
                                                        "avatarId": "",
                                                        "minHeight": 4,
                                                        "maxHeight": 7,
                                                        "position": "bottom",
                                                        "closeWhen": "key",
                                                        "closeButton": "a"
                                                      }
                                                    },
                                                    {
                                                      "id": "bcd8d10b-ee19-4da3-a737-f50cf5c871d1",
                                                      "command": "EVENT_SHOW_SPRITES",
                                                      "args": {}
                                                    }
                                                  ]
                                                }
                                              }
                                            ],
                                            "false": []
                                          }
                                        }
                                      ]
                                    }
                                  }
                                ]
                              }
                            },
