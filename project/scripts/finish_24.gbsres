                                  },
                                  {
                                    "id": "c5ebea91-9218-4766-a7b2-f7de9fca3aa8",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "The city stays\nopen. Explore,\nbuild, and visit\nyour neighbors."
                                      ],
