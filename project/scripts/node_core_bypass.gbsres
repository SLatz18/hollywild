                        "children": {
                          "true": [
                            {
                              "id": "f4a1aa41-41c5-4699-a089-bf64d842aebd",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The public fund\nsets aside six\ntokens for basic\nservice: two for",
                                  "homes, two for\nwork sites, two\nfor shared rooms.\nIt has three more",
                                  "for the first\nimprovements. One\ndraft spends four\nextra tokens on a",
                                  "grand hall and\nsilently takes one\nfrom the home\nbaseline. Nib",
                                  "rejects that draft\nbefore anyone\nvotes. Preferences\nmay decide the",
                                  "extra three; they\nmust not remove\nthe common floor\neveryone agreed",
                                  "to preserve."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
