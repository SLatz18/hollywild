                        "id": "4fcb0585-419a-48f6-aa7d-8ed7cb0763af",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The first service\nplan has four\npressure units\navailable within\nthe safe limit.",
                            "The clinic needs\ntwo, the depot\nneeds one, and the\nfoundry needs one.\nA decorative steam",
                            "arch would take\nanother two. The\narch is optional;\nthe three working\nstops are not. Pip",
                            "admits he drew the\narch before adding\nthe demand\nnumbers. Rivet\nhands him an",
                            "eraser without\ncommenting on its\nimpressive curve."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
