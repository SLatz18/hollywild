                            {
                              "id": "fddb032e-080c-45ad-a687-5f868261c0b6",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "After isolating\nthe leaking lodge\nbranch, how many\nservice units",
                                  "remain as headroom\nwhile all clear\nbranches stay\nsupplied? This",
                                  "margin is not\npermission to\nraise the\nregulator. It\nshows whether",
                                  "the chosen\nresponse fits the\nmeasured safe\nlimit. Slush wants\nthe",
                                  "number written\nbeside the\noperating\ninstruction so a\nfuture crew can",
                                  "see why it was\nsafe."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
