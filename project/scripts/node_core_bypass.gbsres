                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Fault card: Lodge\nbranch closed.\nFrostwick, Candy,\nand Brassworks\nbranches clear.",
                                  "The independent\nbypass is open.\nCorrect response:\nisolate the closed\nlodge branch, keep",
                                  "clear branches\nserved, and send\nthe lodge a fault",
                                  "report. Closing\neverything repeats\nthe old failure."
                                ],
