                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Brassworks\nControl: collect\nDot's signed\nservice setting\ncard."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
