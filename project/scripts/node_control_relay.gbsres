                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "The reserve card\nassigns one spare\nto Velvet and\nmarks it used. Pip",
                                        "logs a replacement\nrequest. The\nreserve does its\njob without",
                                        "pretending it\nstayed full."
                                      ],
