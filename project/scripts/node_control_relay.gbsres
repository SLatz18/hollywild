                      {
                        "id": "f85b66f9-4c8f-46d1-a525-127057e91401",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The Spoon",
                            "A wooden spoon\nrests beside a\ndrawing of the\ncontacts. It is\nnot a",
                            "substitute for\nswitching off\npower. Rivet\nlabeled it for\nmoving",
                            "objects away from\nthe desk before\nwork begins. The\nspoon carries a",
                            "second warning:\nALSO NOT FOR LIVE\nSOUP."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
