                {
                  "id": "e569ccd4-4b47-45d2-adc9-7982ab4bbeab",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Nib: The lodge\nboasts heated\nfloors, a private\nhorizon, and\nmature",
                      "silence. The\nsilence is\nactually a broken\npump. I wrote the\nlisting",
                      "before I saw the\npipe map. I would\nlike to correct\nthat before",
                      "someone believes\nme."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
