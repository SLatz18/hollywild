                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Nib: The lodge\nboasts heated\nfloors, a private\nhorizon, and\nmature silence.",
                            "The silence is\nactually a broken\npump. I wrote the\nlisting before I\nsaw the pipe map.",
                            "I would like to\ncorrect that\nbefore someone\nbelieves me."
                          ],
