                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Velvet Lodge:\ncompare the\ninvoice and sale\nschedule with Nib."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
