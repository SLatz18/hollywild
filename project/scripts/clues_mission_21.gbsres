                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "A message has no\nreceived mark. Who\nis assigned to\ncarry its backup",
                      "copy?"
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
