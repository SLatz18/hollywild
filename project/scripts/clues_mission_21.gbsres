        }
      },
      "children": {
        "true": [
          {
            "id": "4a9e86dc-51f7-40de-abf7-febddd449dad",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "7280de15-7b3f-4445-a496-ab40b6cf8e35",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "29f18011-a07c-4d46-a9cc-35e67784ea49",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "A resident reports\na cold room but\nthe current gauge\nreading is\nunverified. Pip",
                      "must acknowledge\nthe resident and\nrecord the report.\nDot checks the\nreading. Rivet",
                      "decides the\nmechanical repair\nfrom verified\nevidence. Moxie\ncarries a copy if",
                      "the signal reply\nfails. One draft\nskips straight\nfrom complaint to\nordering Rivet to",
                      "replace the pump.\nThe clerk asks who\nhas been left out,\nand why that\nomission matters."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "792b472d-7fdc-4809-aa97-8994328c4195",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
