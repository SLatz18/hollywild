        }
      },
      "children": {
        "true": [
          {
            "id": "d8c1d132-5949-44e0-a7d6-568d0ed07c92",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "504fc996-1593-4992-a22d-fca277e78877",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "f3194436-5be3-42a6-a5e4-20d784cfa1d4",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Before choosing a\nmechanical\nreplacement, whose\nassigned work must\noccur in the",
                      "example? The\nresident report is\nreal and should be\nacknowledged. It\ndoes not by itself",
                      "identify which\npart failed.\nChoose the missing\nverification\nhandoff, so the",
                      "duty register\nprotects both the\nresident from",
                      "delay and the\nbuilder from\nrepairing a guess."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "b27d3dde-73c9-4632-a8b1-c670ca7f43d5",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "acd18cba-fe3e-4f1a-a1c9-8684708f753d",
