        "true": [
          {
            "id": "59e5339f-7259-4bf0-ab26-fb5626c56afb",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "ce35a8c5-480d-413f-a06a-c0680fe815e2",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "cd4eb70f-fad3-4508-a4fe-054d5c05f0be",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Nib reads the\nproposed\nsettlement:\nverified repair\ncosts are repaid",
                      "from the public\nfund in recorded\ninstallments. No\ntenant loses a\nhome to pay it.",
                      "Slush gives up the\nsealed estate\npriority. The city",
                      "takes an actual\ndebt, not a\nflattering favor."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "ca0909d1-6c0f-4b1b-a545-6e95bafd4259",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "bfc742cf-741a-4546-a24b-a53e064057ec",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
