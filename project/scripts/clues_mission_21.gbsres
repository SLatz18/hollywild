        "true": [
          {
            "id": "6e769d3f-c62d-436b-adeb-17328525c3cb",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "d3da1810-8b7e-4e6e-af80-93413a1b5b7e",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "22d7d74b-70d3-45cf-ae7a-61ea18d26ef7",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush: I still\nprefer a building\nwith my name on\nit. But a city\nthat works is a",
                      "better neighbor\nthan an estate\nsurrounded by\ncold. He offers\nthe umbrella to",
                      "Pip, who discovers\nit is heavy\nbecause the handle\nstores twelve\nemergency forms."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "fc62669a-41c5-4f2c-a4ab-7a9ca85e174f",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
