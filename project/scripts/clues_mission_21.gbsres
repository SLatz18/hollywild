                  "args": {}
                },
                {
                  "id": "470612d2-e6fa-4ab7-a8c9-69db978dba68",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Register: Rivet\nmaintains valves.\nDot verifies\nreadings. Moxie",
                      "carries failed\nmessage copies.\nPip records faults\nand informs",
                      "residents. The\nclerk keeps the\npublic access\nagreement. Slush\noffers",
                      "his roof crew for\nlodge repairs,\nsubject to the\nsame written fault",
                      "log."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "db71887e-6abb-4b5c-a4a7-fc564e2b0a93",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "c7d8c423-96f1-4d2b-ab59-3d72bd3607b8",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "30447e89-0087-43bb-ac37-c609ac584569",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "bf59d5fa-0500-4d68-a351-7497c5aa9aaf",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "6e553fc5-93f7-4263-a2ab-071599a1f83e",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "A resident reports\na cold room but\nthe current gauge\nreading is",
                      "unverified. Pip\nmust acknowledge\nthe resident and\nrecord the report.",
                      "Dot checks the\nreading. Rivet\ndecides the\nmechanical repair\nfrom",
                      "verified evidence.\nMoxie carries a\ncopy if the signal\nreply fails.",
                      "One draft skips\nstraight from\ncomplaint to\nordering Rivet to\nreplace",
                      "the pump. The\nclerk asks who has\nbeen left out, and\nwhy that",
                      "omission matters."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "beda9fac-052f-4aef-a9ad-4d49287a365c",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
