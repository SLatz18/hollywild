                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The blue parcel\nhas a stitched\nsquare and smells\nfaintly of cedar.\nInside the tag, a",
                            "nurse has written:\nThank you for\nsending things\nthat fit actual\npeople. Moxie",
                            "checks the seal,\nthen marks this as\na protected\ndelivery."
                          ],
