                              "id": "e049cc59-0a16-4b57-a6fa-4add0221eb5e",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Which action meets\nboth handling\nneeds without\nchanging who\nreceives",
                                  "either item? The\naddress tags can\nmove with their\ncontents. Nothing",
                                  "is spoiled yet,\nand there is no\nhurry. A correct\ndelivery means",
                                  "checking the\nparcel as well as\nthe name on it.\nMoxie waits with\nthe",
                                  "dispatch pen\ninstead of\nrewarding the\nfirst answer."
                                ],
                                "avatarId": "",
