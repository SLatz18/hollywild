                              "id": "32e44553-fcdf-4d87-a809-1d9b1448b506",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The spring sits\ninside a biscuit\ntin marked DO NOT\nEAT ENGINEERING.",
                                  "The brass key\nhangs beside it.\nRivet checks both\nagainst her",
                                  "drawing. Rivet\ntags the parts for\npublic repair and\nlocks their",
                                  "carrying case.\nWhatever you build\nfor yourself,\nthese belong to\nthe",
                                  "network."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
