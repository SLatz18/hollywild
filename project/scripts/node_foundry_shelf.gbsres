                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Brassworks\nFoundry: collect\nthe tagged gears."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
