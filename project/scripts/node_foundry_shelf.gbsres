                              "id": "45843b93-2ab2-4413-ace2-adbb004ce370",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The spring sits\ninside a biscuit\ntin marked DO NOT\nEAT ENGINEERING.\nThe brass key",
                                  "hangs beside it.\nRivet checks both\nagainst her\ndrawing. Rivet\ntags the parts for",
                                  "public repair and\nlocks their\ncarrying case.\nWhatever you build\nfor yourself,",
                                  "these belong to\nthe network."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
