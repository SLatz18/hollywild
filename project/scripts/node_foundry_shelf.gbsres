                      {
                        "id": "e7b3db03-44b7-4bf2-a702-7ef419f24f19",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Rivet has two\nsprings. The short\nspring closes a\nvalve that travels\ntwo marks. The",
                            "long spring closes\none that travels\nfour. This\nregulator travels\nfour marks and",
                            "must close fully\nwith power off.\nBoth springs look\nclean. A trainee\nchose the short",
                            "one because it\nfits the tin more\nneatly. Rivet asks\nyou to explain the\nselection without",
                            "making the trainee\nafraid to ask\nanother question."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
                      {
                        "id": "96efb65b-d408-42ac-adf0-7ab9cd6ba178",
