                  "id": "2015afcc-4ed0-4d2e-a46d-7a9ce36ba2a1",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: The point\nis that each\nparcel has a\nreason to be on\nthe cart.",
                      "We are not making\nthe city look\nsupplied. We are\nsupplying it. She",
                      "keeps the spare\nlabel in case\nsomeone tries to\nsend the clinic a",
                      "decorative gong."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
