                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The blue parcel\nhas a stitched\nsquare and smells\nfaintly of cedar.",
                      "Inside the tag, a\nnurse has written:\nThank you for\nsending things",
                      "that fit actual\npeople. Moxie\nchecks the seal,\nthen marks this as\na",
                      "protected\ndelivery."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
