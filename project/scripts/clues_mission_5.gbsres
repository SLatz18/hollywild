      "children": {
        "true": [
          {
            "id": "2bea25c2-5d77-4965-a536-3e34648ff982",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "2550c7e8-5fbb-4fb5-a267-01f858cd4b4b",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "60b27877-bd41-449c-a1eb-95c585510272",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The blue parcel\nhas a stitched\nsquare and smells\nfaintly of cedar.\nInside the tag, a",
                      "nurse has written:\nThank you for\nsending things\nthat fit actual\npeople. Moxie",
                      "checks the seal,\nthen marks this as\na protected\ndelivery."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "cdf6d548-42f5-46d4-a987-4b96938a7934",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
