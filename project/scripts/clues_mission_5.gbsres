                  "args": {}
                },
                {
                  "id": "35ac86f7-7285-4623-a1a7-c8172f73c0ac",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Address board: The\nclinic takes\nblankets, never\nbells. The roof\nwatch takes bells,",
                      "never food. Cocoa\nCorner takes the\nsoup tin. Red\nshelf holds bells.\nBlue shelf holds",
                      "blankets. The soup\nis already at the\ndispatch desk."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "304bffaa-ab5f-4310-aa61-826c0d407425",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
