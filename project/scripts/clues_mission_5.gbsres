        "true": [
          {
            "id": "ce010dd4-81a3-4a67-a71e-c7748c162178",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "8cb0a1f1-b527-4cdf-a174-ea1ecdbafb4d",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "bfbbca50-664f-42ee-abc4-78a56c5ee10c",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which action meets\nboth handling\nneeds without\nchanging who\nreceives either",
                      "item? The address\ntags can move with\ntheir contents.\nNothing is spoiled\nyet, and there is",
                      "no hurry. A\ncorrect delivery\nmeans checking the\nparcel as well as\nthe name on it.",
                      "Moxie waits with\nthe dispatch pen\ninstead of\nrewarding the\nfirst answer."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "6e749cf8-4d74-4902-a65c-51a5c239fa66",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
