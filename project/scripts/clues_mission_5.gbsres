                  "args": {}
                },
                {
                  "id": "6c83b2b0-6927-4d4f-a91c-ac0c4e111ff9",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: The point\nis that each\nparcel has a\nreason to be on\nthe cart. We are",
                      "not making the\ncity look\nsupplied. We are\nsupplying it. She\nkeeps the spare",
                      "label in case\nsomeone tries to\nsend the clinic a\ndecorative gong."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "1a2ab657-9715-4195-aed5-5bfec9f5e2ed",
