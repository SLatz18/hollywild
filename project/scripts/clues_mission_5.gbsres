                {
                  "id": "62dba545-9b05-457c-a4ad-62e2059ad45a",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Address board: The\nclinic takes\nblankets, never\nbells. The roof",
                      "watch takes bells,\nnever food. Cocoa\nCorner takes the\nsoup tin. Red",
                      "shelf holds bells.\nBlue shelf holds\nblankets. The soup\nis already at",
                      "the dispatch desk."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
