                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Choose the\ndestination for\nthe red shelf\nparcel. Use the\ncontents and",
                      "recipient rules on\nthe address board,\nrather than the\ncolor alone."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
