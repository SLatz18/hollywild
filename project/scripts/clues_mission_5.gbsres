                  "args": {}
                },
                {
                  "id": "c97c27aa-671f-4815-a831-c9e1c9f748bd",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "A second shipment\nhas a tin of soup\nand a packet of\npaper medicine",
                      "labels. The clinic\ntakes the labels\nand requires a dry\ncontainer.",
                      "Cocoa takes soup\nand can accept a\nwashable crate.\nThe only dry box",
                      "holds the soup;\nthe washable crate\nholds the labels.\nBoth containers",
                      "have correct\naddress tags for\ntheir contents.\nMoxie says the\ntags",
                      "are right but the\npacking still\nneeds a decision."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
