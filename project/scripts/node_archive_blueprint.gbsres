                              "id": "c4bfc3ef-6967-47ea-a63b-00bb5008922b",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The Mapmaker\nEraser",
                                  "Along the old map\nedge, a route\ndisappears beneath\nan eraser mark. A",
                                  "note explains that\nthe lane was\nremoved because\nthe stair\ncollapsed,",
                                  "not because the\nresidents stopped\nmattering. A later\nhand restores",
                                  "the route through\na service hall."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
