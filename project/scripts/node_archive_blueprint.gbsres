                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The old route\njoins Frostwick\nDepot, Candy\nSorting,\nBrassworks",
                            "Control, Velvet\nLodge, and Aurora\nSignal. The\nnorthern roof line",
                            "reaches couriers\nquickly. The\nsouthern sheltered\nline keeps parcels",
                            "dry. Both are\npublic routes,\ndespite the newer\nmap."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
