              "true": [
                {
                  "id": "c7a88450-4152-443a-ae92-c2417f98fea6",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The table holds\nthree index notes.\nDecember: repairs\ncomplete,",
                      "signed by the\nengineer. January:\nsale proposed,\nunsigned.\nFebruary:",
                      "ownership\nunchanged until a\ndeed is signed and\nentered. A\nresident",
                      "named Mara needs\nto know who must\nfix her leaking\nstair pipe. She",
                      "has already been\nsent between three\ndesks. The clerk\nsays a later",
                      "date does not make\nan unsigned\nproposal into a\ncompleted\ntransfer."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "9838ce14-a169-4a15-a513-8f43fd094da4",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 2
                    }
                  }
                },
                {
                  "id": "9c6e4247-b819-4903-a92e-8d821a1e0676",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Frostwick Archive:\nchoose the public\nservice seal at\nthe catalog."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
