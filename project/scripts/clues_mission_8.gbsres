      },
      "children": {
        "true": [
          {
            "id": "7be8f266-b8e4-453b-acc8-a544afb5c6b2",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "86877ae1-c08f-4b92-a559-efe870e844e5",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "406850ca-2dbb-43ae-abe6-4c4a523a1a9f",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The regulator\ncrate weighs six\nunits. The west\nroof bridge holds",
                      "three. The east\nstair holds five.\nThe depot gate\nholds eight. The",
                      "crate must travel\nintact because its\nspring is secured\ninside a",
                      "sealed test frame.\nMoxie cannot split\nit into two trips\nwithout",
                      "invalidating the\ntest. The gate\nroute is longer on\nthe drawing but",
                      "has no toll,\ntimer, or closed\ndoor."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "72c71157-edc9-48fd-acef-b2caaff520f8",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
