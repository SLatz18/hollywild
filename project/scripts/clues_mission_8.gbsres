        }
      },
      "children": {
        "true": [
          {
            "id": "9904c462-080b-422b-a034-f799c553762d",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "ebbc3a97-ec4b-489b-a258-c91af4ee7c36",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "01493c3c-c750-4c5b-a5de-8f58e480bbdf",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The regulator\ncrate weighs six\nunits. The west\nroof bridge holds\nthree. The east",
                      "stair holds five.\nThe depot gate\nholds eight. The\ncrate must travel\nintact because its",
                      "spring is secured\ninside a sealed\ntest frame. Moxie\ncannot split it\ninto two trips",
                      "without\ninvalidating the\ntest. The gate\nroute is longer on\nthe drawing but",
                      "has no toll,\ntimer, or closed\ndoor."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "8e80c06f-47b0-47e0-a374-eac7a90c5681",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
