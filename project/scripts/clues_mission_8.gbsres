                {
                  "id": "b0336fa3-4b00-496d-a09d-baa5a699dcde",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: I will keep\nthe stop list and\nlog a missed call.\nPip will",
                      "answer when I\nreport one. Nobody\ngets to replace\nthe word missed",
                      "with almost. The\nroof watch\nvolunteers a dry\nshelf for the log."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "960f72e0-b45b-436f-a816-df7ca76071cd",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
