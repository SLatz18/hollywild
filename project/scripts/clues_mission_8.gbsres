                  "args": {}
                },
                {
                  "id": "be21d765-c58a-4e2f-a6b2-e45598554d1f",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Survey: The west\nservice bridge\nbears parcels, not\nmachinery. The\neast stair bears a",
                      "hand cart. Heavy\nregulator parts\nmust travel by\ndepot gate. Nib\nasks whether",
                      "describing the\nbridge as intimate\nwould help. Rivet\nanswers without\nlooking up."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "f865af25-4e53-46fa-aa66-6ce39412e9fd",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "892ce64c-dff9-4999-a36e-99b6494d671e",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
