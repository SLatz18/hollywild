                {
                  "id": "237acbfc-fd86-4ef8-a1b3-db1d68473ac7",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: I will keep\nthe stop list and\nlog a missed call.\nPip will answer\nwhen I report one.",
                      "Nobody gets to\nreplace the word\nmissed with\nalmost. The roof\nwatch volunteers a",
                      "dry shelf for the\nlog."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "d96f4dfc-ac2d-47e6-ad1a-54bff0eb50a3",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
