                      {
                        "id": "6a769266-214f-4c38-a314-ebbdef83e233",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Rivet presents a\nDIFFERENT practice\norder, separate\nfrom the two-seal\nstandard",
                            "inspection. This\norder needs\nexactly three\nseals, with no\nspare output",
                            "because the mix\nexpires. Six stock\nunits are\navailable; two\nmust remain for",
                            "another crew.\nRecipe A uses two\nstock for two\nseals. Recipe B\nuses four stock",
                            "for three. Only\nwhole batches are\nallowed. The first\nstandard\ninspection and",
                            "this practice\norder must each be\nplanned on their\nown terms."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
