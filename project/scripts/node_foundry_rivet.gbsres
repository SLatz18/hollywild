                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Rivet: A gear\nmoves the valve. A\nspring pulls it\nshut when power\nfails. A brass key",
                            "sets the limit.\nNone is optional.\nThe old machine\nhad a marvelous\nopening motion and",
                            "a closing spring\nborrowed to fix a\nmusical chair."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
