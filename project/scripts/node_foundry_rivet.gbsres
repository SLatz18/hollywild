              "true": [
                {
                  "id": "d9af4fb8-8a0f-482e-afcc-6ae665a5378d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Rivet: A gear\nmoves the valve. A\nspring pulls it\nshut when power",
                      "fails. A brass key\nsets the limit.\nNone is optional.\nThe old machine",
                      "had a marvelous\nopening motion and\na closing spring\nborrowed to fix",
                      "a musical chair."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "cff05a32-6ce3-49bf-a89a-571f949b96a4",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 1
                    }
                  }
                },
                {
                  "id": "958a2ef5-0a93-4efe-a007-148aeb534e04",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Brassworks\nFoundry: compare\nthe two spring\ntags on the shelf."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
