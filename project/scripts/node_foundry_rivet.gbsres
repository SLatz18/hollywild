              "true": [
                {
                  "id": "b8b82918-d440-4106-a5b2-d690cd20a2a6",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Rivet: A gear\nmoves the valve. A\nspring pulls it\nshut when power",
                      "fails. A brass key\nsets the limit.\nNone is optional.\nThe old machine",
                      "had a marvelous\nopening motion and\na closing spring\nborrowed to fix",
                      "a musical chair."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "0db1fb55-710c-4a6d-a40a-0de992ef18a7",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 1
                    }
                  }
                },
                {
                  "id": "461255bd-4ce7-4592-a544-66114cfde1be",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Brassworks\nFoundry: compare\nthe two spring\ntags on the shelf."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
