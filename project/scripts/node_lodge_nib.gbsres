                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Nib reads the\nproposed\nsettlement:\nverified repair\ncosts are repaid",
                                              "from the public\nfund in recorded\ninstallments. No\ntenant loses a",
                                              "home to pay it.\nSlush gives up the\nsealed estate\npriority. The city",
                                              "takes an actual\ndebt, not a\nflattering favor."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
