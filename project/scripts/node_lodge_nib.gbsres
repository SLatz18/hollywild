                                          "id": "aa2e9ac3-19d6-44d3-a552-ddad67f288ff",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Nib reads the\nproposed\nsettlement:\nverified repair\ncosts are repaid",
                                              "from the public\nfund in recorded\ninstallments. No\ntenant loses a\nhome to pay it.",
                                              "Slush gives up the\nsealed estate\npriority. The city",
                                              "takes an actual\ndebt, not a\nflattering favor."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
