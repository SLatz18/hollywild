                                  {
                                    "id": "3dce45dc-4de7-4790-a30b-4cf58640679d",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Nib reads the\nproposed\nsettlement:\nverified repair\ncosts are repaid",
                                        "from the public\nfund in recorded\ninstallments. No\ntenant loses a",
                                        "home to pay it.\nSlush gives up the\nsealed estate\npriority. The city",
                                        "takes an actual\ndebt, not a\nflattering favor."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
                                  },
                                  {
                                    "id": "c2208267-96b3-4a16-a433-9eb1bcd64acf",
                                    "command": "EVENT_IF",
                                    "args": {
                                      "condition": {
                                        "type": "eq",
                                        "valueA": {
                                          "type": "variable",
                                          "value": "48"
                                        },
                                        "valueB": {
                                          "type": "number",
                                          "value": 1
                                        }
                                      }
                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "856be0b8-22b9-489d-a8be-a8d25d939adf",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "The joint review\nkept Slush's\nprivate tenant\nnotes out of the",
                                              "settlement. Dot\nverified the\nrepair sums\nseparately; the\nclerk",
                                              "publishes only the\nagreed totals."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
                                            "closeWhen": "key",
                                            "closeButton": "a"
                                          }
                                        }
                                      ],
                                      "false": []
                                    }
                                  },
