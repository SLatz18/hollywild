                              "children": {
                                "true": [
                                  {
                                    "id": "5aae53bd-8ef6-42b4-a910-099f341ce271",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Nib reads the\nproposed\nsettlement:\nverified repair\ncosts are repaid",
                                        "from the public\nfund in recorded\ninstallments. No\ntenant loses a",
                                        "home to pay it.\nSlush gives up the\nsealed estate\npriority. The city",
                                        "takes an actual\ndebt, not a\nflattering favor."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
                                  },
                                  {
                                    "id": "e91adaac-cfb1-4121-a63f-67f3bc1774ef",
                                    "command": "EVENT_IF",
                                    "args": {
                                      "condition": {
                                        "type": "eq",
                                        "valueA": {
                                          "type": "variable",
                                          "value": "48"
                                        },
                                        "valueB": {
                                          "type": "number",
                                          "value": 1
                                        }
                                      }
                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "7fd7f860-39ab-4748-accb-9ac1011c91d4",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "The joint review\nkept Slush's\nprivate tenant\nnotes out of the",
                                              "settlement. Dot\nverified the\nrepair sums\nseparately; the\nclerk",
                                              "publishes only the\nagreed totals."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
                                            "closeWhen": "key",
                                            "closeButton": "a"
                                          }
                                        }
                                      ],
                                      "false": []
                                    }
                                  },
                                  {
                                    "id": "ec537ec9-fcd8-4d1c-a2c0-07b45ec92292",
                                    "command": "EVENT_IF",
                                    "args": {
                                      "condition": {
                                        "type": "eq",
                                        "valueA": {
                                          "type": "variable",
                                          "value": "48"
                                        },
                                        "valueB": {
                                          "type": "number",
                                          "value": 2
