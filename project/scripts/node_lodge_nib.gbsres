                                      }
                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "8e1465b2-60cb-45c6-a045-f816efd84aa5",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "The witnessed\npublic review\npublishes the\nrepair totals and\ntest",
                                              "records. Tenant\nnames remain\nprivate. Slush\nsigns beneath the\nsame",
                                              "figures the clerk\nchecked."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
