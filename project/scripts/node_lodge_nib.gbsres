            "children": {
              "true": [
                {
                  "id": "37ac0a75-1ced-4e7d-ac03-d8e92389db0d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Nib lays two pages\nside by side. The\ninvoice names one\nvalve",
                      "inspection and six\nrepaired roof\npanels. The sale\nschedule names the",
                      "lodge walls and\ncourtyard but\nexcludes municipal\npipes. A tempting",
                      "summary says Slush\npaid for\neverything below\nthe roof. Nib\ncrosses",
                      "it out. The\ninspection bill\nnames a service,\nnot a transfer of\nthe",
                      "inspected object.\nHe asks for\nwording a nervous\nbuyer could safely",
                      "repeat."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "129a5bc1-e9dc-4965-a830-213d751f9e5a",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 2
                    }
                  }
                },
                {
                  "id": "74731e2d-4157-407a-af9a-6783fe5f1790",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Velvet Lodge:\ncollect the\ndisclosure from\nthe disclosure\ndesk."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
