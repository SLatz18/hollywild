            "children": {
              "true": [
                {
                  "id": "42f98dd3-bad1-4ae8-a0f0-f6b01c720a71",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "d95bbf13-2be7-4095-a485-e573d8e5d7ad",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie pins your\nroute on the\nsorting desk. She\nstops calling the",
                      "project a rescue.\nRescue sounds like\none brave person,\nshe says. A",
                      "route needs\nsomebody to do it\nagain tomorrow.\nPip quietly\nchanges",
                      "the heading."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "b78e6a62-d01f-4bbd-a021-574e1b56d635",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
