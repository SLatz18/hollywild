                  "args": {}
                },
                {
                  "id": "7676f3fa-d40a-4fdc-a5a4-3fb973c89315",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie pins your\nroute on the\nsorting desk. She\nstops calling the\nproject a rescue.",
                      "Rescue sounds like\none brave person,\nshe says. A route\nneeds somebody to\ndo it again",
                      "tomorrow. Pip\nquietly changes\nthe heading."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
