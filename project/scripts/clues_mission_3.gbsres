        "true": [
          {
            "id": "fc2d794c-eb2c-4d09-a527-9cad89ad786e",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "eb00701e-495b-49b8-abdc-446f55113540",
