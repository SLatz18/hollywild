          }
        }
      },
      "children": {
        "true": [
          {
            "id": "fc9bef8c-73ee-42a0-a294-f0ccecd48124",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "39958129-de1e-4540-a942-3f262a003733",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "f4c36dda-b5bf-43aa-a26e-e074bf3346a1",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: I can take\nthe high line.\nThree turns,\nexcellent view,\nterrible hat",
                      "insurance. The\ncovered route\nserves the clinic.\nIt is longer but\ngives me someone",
                      "to talk to besides\nweather vanes.\nPick a promise we\ncan keep."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "a3fdbdbb-a67d-449d-a690-22581eac9a29",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "cf9c9c90-5893-434e-a89e-b9a6cf6ebbd6",
      "command": "EVENT_IF",
      "args": {
        "condition": {
