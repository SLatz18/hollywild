            "children": {
              "true": [
                {
                  "id": "ca515607-2aad-47c9-ab1f-067f131ca59b",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie has six\nsmall parcels for\nthe first round.\nHer roof harness",
                      "carries three at a\ntime; the covered\nhandcart carries\nall six. The",
                      "high line is\nchecked in two\ntrips, and the\ncovered line in\none.",
                      "Neither route has\na timer. The\nclinic wants a\ncomplete delivery",
                      "record, not a\nspeed boast. Moxie\nasks how many\ntrips the larger\ncart",
                      "saves on this\nround."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "49802553-4b0c-4b17-aa95-c1a12c922ea6",
                  "command": "EVENT_SET_VALUE",
