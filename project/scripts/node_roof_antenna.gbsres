                        "id": "1b95d5b7-6863-4eb8-a9b9-064e33bfe270",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Dot: The bell wire\ngoes to this\nantenna. Its brass\ntag says SEND",
                            "NORTH. The vane\npoints toward\nAurora when its\narrow meets the\nnotch.",
                            "Wind moved the\nvane, but the\nnotch is still cut\ninto the stone."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
