                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Candy Rooftops:\nspeak to the\ncourier beside the\nroof landing."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
