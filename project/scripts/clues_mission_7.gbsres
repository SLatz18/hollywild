          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "d5e04d68-1b77-4eb6-a753-9508dc252ec5",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "e7ecaa56-6257-4013-ad19-c0175bd9acbf",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "80a9c0bd-7a3c-4fa5-aafe-f7c44cfd1ea8",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The release\nchecklist requires\ntwo facts: public\nownership and a\ncleared repair",
                      "charge. The\nsorting register\nproves ownership;\nthe paid repair\nline proves the",
                      "charge cleared.\nThe storage\ndispute belongs on\na separate\naccount. A",
                      "substitute form\noffers release if\nMoxie signs a\npersonal loan. She\ncould sign",
                      "quickly, but it\nwould turn a\npublic paperwork",
                      "error into her\nprivate debt. She\nputs the pen down."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "ec7c0df5-6f28-4d91-a8b8-7dbe573141b0",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
