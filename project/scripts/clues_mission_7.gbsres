                  "args": {}
                },
                {
                  "id": "9cc57373-4861-403d-ac8b-31c81fe8d7d7",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The sled register\nlists the city as\nowner. Its repair\ncharge was",
                      "paid from a public\nfund. Storage is\nthe only unpaid\nitem. A penciled",
                      "note says\nequipment cannot\nbe pledged by a\ndriver. Moxie\nlooks",
                      "deeply relieved by\nthis detail."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "7f227bed-27bb-4342-ac13-0121fb555c33",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "e6c9e1f8-8a03-4260-a514-105d81d79724",
