                  "args": {}
                },
                {
                  "id": "450abca2-a430-4161-a0ca-3d3153a4a6bb",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which packet\nsatisfies the two\nrelease conditions\nwithout making\nMoxie personally",
                      "liable? The clerk\ncan attach more\nthan one document.\nDo not solve a\nmissing proof by",
                      "inventing a new\nborrower. Moxie\nsays she will wait\nwhile you get it\nright; the sled",
                      "belongs to the\ncity, and so does\nthe duty to keep\nits records\nstraight."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "b0336fa3-4b00-496d-a09d-baa5a699dcde",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
