                {
                  "id": "3d438571-d1f0-4ecb-aa2d-f314a2990d7b",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: We can use\nthe sled again\nwithout pretending\nthe storage bill",
                      "disappeared. That\nis a surprisingly\ngrown up victory.\nShe writes",
                      "REPAIR THE RUNNER\nbefore drawing a\nracing stripe. The\nstripe comes",
                      "second, by a\nnarrow vote."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
