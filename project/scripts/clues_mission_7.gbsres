                {
                  "id": "18b239a0-1646-4a8a-ad0b-8e8f486fbe12",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: We can use\nthe sled again\nwithout pretending\nthe storage bill\ndisappeared. That",
                      "is a surprisingly\ngrown up victory.\nShe writes REPAIR\nTHE RUNNER before\ndrawing a racing",
                      "stripe. The stripe\ncomes second, by a\nnarrow vote."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
