                  "args": {}
                },
                {
                  "id": "2e3fe815-495f-4c32-a5cc-539548febfe2",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The sled register\nlists the city as\nowner. Its repair\ncharge was paid\nfrom a public",
                      "fund. Storage is\nthe only unpaid\nitem. A penciled\nnote says\nequipment cannot",
                      "be pledged by a\ndriver. Moxie\nlooks deeply\nrelieved by this\ndetail."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "2c166d0a-4bee-4065-aa25-2cbb83bcb534",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
