                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Manifest: Vehicle\nloan: none. Repair\ndebt: cleared.\nStorage claim:\ndisputed. Release",
                      "requires the\nmunicipal owner\nmark, a square.\nThe crown stamp\nwould transfer a",
                      "private vehicle,\nwhich this sled\nhas never been."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
