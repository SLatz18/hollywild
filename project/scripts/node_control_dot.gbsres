                              "args": {}
                            },
                            {
                              "id": "53b393fd-43a6-4b31-a6cf-3ac2c0feed42",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Dot tests the\nbucket itself\nbefore blaming the\ngauge. A certified",
                                  "jug pours one unit\nto its first mark\nand another unit\nto its second.",
                                  "The bucket agrees\non both. The open\nline is visibly\nempty when the",
                                  "pump is off. A\nspare gauge from a\nprivate showroom\nhas no test",
                                  "record. Slush\noffers it anyway,\nthen listens when\nDot explains that",
                                  "a more expensive\nreading is not\nindependent\nevidence."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
