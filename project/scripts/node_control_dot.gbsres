                                              {
                                                "id": "be1d54f6-179f-42a5-a1de-b42c39aa41dc",
                                                "command": "EVENT_TEXT",
                                                "args": {
                                                  "text": [
                                                    "The drill adds\nmeasured demand:\nclear branches\nneed three units\ntogether. The",
                                                    "faulty lodge\nbranch leaks two\nextra units. Safe\nservice is four.\nIsolating the",
                                                    "lodge removes the\nleak and leaves\nthe clear branches\nat three. Raising\nthe service",
                                                    "setting to six\nwould hide the\nshortage without\nrepairing the\nfault, and six is",
                                                    "still only a test\nceiling. Slush\nchecks the\narithmetic himself\nand does not like",
                                                    "how familiar the\nwrong plan feels."
                                                  ],
                                                  "avatarId": "",
                                                  "minHeight": 4,
                                                  "maxHeight": 7,
                                                  "position": "bottom",
                                                  "closeWhen": "key",
                                                  "closeButton": "a"
                                                }
