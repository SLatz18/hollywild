                                  {
                                    "id": "289030b5-69f0-4b44-ab7c-6a71fa338adf",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "The lock card adds\na condition to the\nprocess sheets:\nthe crew must",
                                        "disconnect power\nbefore opening the\nregulator cover.\nThe spring is",
                                        "fitted with the\ncover open. The\nlimit is set after\nthe spring is",
                                        "secured. The cover\nis then shut\nbefore power\nreturns for\ntesting.",
                                        "Dot arranges blank\ncards on the desk\nand asks the\ninspector to keep",
                                        "his silver ruler\naway from all of\nthem."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
