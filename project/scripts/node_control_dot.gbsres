                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Brassworks\nControl: inspect\nthe two batch\nrecipes on the\npump desk."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
