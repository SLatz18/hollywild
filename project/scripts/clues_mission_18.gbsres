                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie repeats the\nsignal and names\nthe depot handoff.\nShe asks Pip to\nstop calling her",
                      "the emergency\nmiracle. A courier\nis a normal part\nof the plan, she\nsays. Miracles",
                      "have terrible\nmaintenance\nschedules."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
