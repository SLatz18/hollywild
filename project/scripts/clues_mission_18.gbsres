                  "args": {}
                },
                {
                  "id": "daa068c9-7f42-4955-a059-cfa7e385a9b5",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: STEADY\nmeans message\nreceived. DOUBLE\nmeans send the\ncourier. DARK",
                      "means no confirmed\nsignal, so check\nin person. No\nrapid flashing,\nand no color test.",
                      "We use a plain\nwritten card at\nevery post as well\nas the lamp."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "87fa9178-efbe-4042-ac94-7cfc6c587f13",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "59789196-44aa-436b-aca1-11cc70829cef",
      "command": "EVENT_IF",
      "args": {
        "condition": {
