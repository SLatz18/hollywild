                {
                  "id": "ffa6f7ad-2891-4e6f-a69c-d2057d5ea31c",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The card uses\nwords and distinct\nmarks. Pip can\nread it at arm\nlength; Moxie can",
                      "read it through a\nscarf. Nib\nproposes a gold\nborder. The clerk\npermits the border",
                      "after he proves it\ncovers none of the\ninstructions."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
