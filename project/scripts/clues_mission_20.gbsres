                  "args": {}
                },
                {
                  "id": "49668cb4-1caa-4da3-a35b-dc69dc8d3b4f",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Fault card: Lodge\nbranch closed.\nFrostwick, Candy,\nand Brassworks",
                      "branches clear.\nThe independent\nbypass is open.\nCorrect response:",
                      "isolate the closed\nlodge branch, keep\nclear branches\nserved, and",
                      "send the lodge a\nfault report.\nClosing everything\nrepeats the old",
                      "failure."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "f6d88e88-2af7-418a-ab64-1637bd9fc6d8",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "d4a54b6f-4ba1-4651-ac34-1dab9177beab",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "9d1c0cfb-176a-464d-afe6-9c1dfa671669",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "3c609d1a-a890-43a5-a201-a306e4d88358",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "ef8addb3-08f0-41ca-ab2d-9c0b2319937e",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The drill adds\nmeasured demand:\nclear branches\nneed three units",
                      "together. The\nfaulty lodge\nbranch leaks two\nextra units. Safe",
                      "service is four.\nIsolating the\nlodge removes the\nleak and leaves\nthe",
                      "clear branches at\nthree. Raising the\nservice setting to\nsix would",
                      "hide the shortage\nwithout repairing\nthe fault, and six\nis still only",
                      "a test ceiling.\nSlush checks the\narithmetic himself\nand does not",
                      "like how familiar\nthe wrong plan\nfeels."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "260e630e-e80c-4c9c-afd7-a28f2924114f",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
