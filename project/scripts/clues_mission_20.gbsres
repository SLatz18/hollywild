                {
                  "id": "30447e89-0087-43bb-ac37-c609ac584569",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The paper test\ncalls for one\nreplacement seal\nat Velvet. Rivet\nasks the crew to",
                      "show the stock\nentry and name the\nreplenishment duty\nbefore calling the\nrepair supplied."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
