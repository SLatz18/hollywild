    {
      "id": "07ae32f9-6ae2-48d4-a6bf-37340ca8c206",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
