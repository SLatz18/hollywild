      },
      "children": {
        "true": [
          {
            "id": "186c1278-d3b2-45ef-afaa-e173a03e6c4e",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "c16f8dc7-ecb5-4770-a6f2-3fd634d02383",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "fa7a91ba-20db-482a-a33e-a73eb8682c0d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "After isolating\nthe leaking lodge\nbranch, how many\nservice units\nremain as headroom",
                      "while all clear\nbranches stay\nsupplied? This\nmargin is not\npermission to",
                      "raise the\nregulator. It\nshows whether the\nchosen response\nfits the measured",
                      "safe limit. Slush\nwants the number\nwritten beside the\noperating\ninstruction so a",
                      "future crew can\nsee why it was\nsafe."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "2b9014d6-ed8b-4f7b-a924-95ad3a6ccb01",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
