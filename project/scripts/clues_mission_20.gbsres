                  "args": {}
                },
                {
                  "id": "f05aa54d-d2c8-439e-a291-fad0b0e5aac7",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Fault card: Lodge\nbranch closed.\nFrostwick, Candy,\nand Brassworks\nbranches clear.",
                      "The independent\nbypass is open.\nCorrect response:\nisolate the closed\nlodge branch, keep",
                      "clear branches\nserved, and send\nthe lodge a fault",
                      "report. Closing\neverything repeats\nthe old failure."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "8e022610-899b-45f4-a985-1daf9fc8a7c2",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "db71887e-6abb-4b5c-a4a7-fc564e2b0a93",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "062ea2f2-5c8e-4904-a3fa-fde3cd1e9c2c",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "8381f4ad-5557-443a-a712-c0387163a4fa",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "247a589c-9457-4e10-a0ef-20b0a3faef89",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The drill adds\nmeasured demand:\nclear branches\nneed three units\ntogether. The",
                      "faulty lodge\nbranch leaks two\nextra units. Safe\nservice is four.\nIsolating the",
                      "lodge removes the\nleak and leaves\nthe clear branches\nat three. Raising\nthe service",
                      "setting to six\nwould hide the\nshortage without\nrepairing the\nfault, and six is",
                      "still only a test\nceiling. Slush\nchecks the\narithmetic himself\nand does not like",
                      "how familiar the\nwrong plan feels."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "470612d2-e6fa-4ab7-a8c9-69db978dba68",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
