        "true": [
          {
            "id": "8ed3c560-3b35-4472-a181-32575edc08bd",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "8556b3a1-25f6-4a43-a9be-12755a9e4679",
