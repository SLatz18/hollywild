            "children": {
              "true": [
                {
                  "id": "857f9b47-0adf-40f9-a984-29e29df3f75e",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "f5df1e8e-f440-4e28-a995-26a4b62a86bc",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush: My plan\nprotected one\ndistrict by\nexcluding the\nrest. Yours keeps",
                      "the rest served\nwhile admitting\none needs help.\nThat is a\ndistinction with a",
                      "machine behind it.\nHe signs the trial\nresult and asks to\nkeep the paper\nfault card."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
