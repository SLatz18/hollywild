      "children": {
        "true": [
          {
            "id": "4676ff12-fb88-4ee6-afde-129987909938",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "2006eb52-f83d-48d7-a451-be57d6e66b34",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "3cfab148-4969-474d-aacd-cf09ded836a2",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush: My plan\nprotected one\ndistrict by\nexcluding the\nrest. Yours",
                      "keeps the rest\nserved while\nadmitting one\nneeds help. That\nis a",
                      "distinction with a\nmachine behind it.\nHe signs the trial\nresult and",
                      "asks to keep the\npaper fault card."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "43e83b63-d5f1-4557-aef7-9635db9dd9fd",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
