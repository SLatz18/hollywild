                  "args": {}
                },
                {
                  "id": "34b1a241-1996-4189-ae8a-79aab16473e0",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The paper test\ncalls for one\nreplacement seal\nat Velvet. Rivet\nasks",
                      "the crew to show\nthe stock entry\nand name the\nreplenishment duty",
                      "before calling the\nrepair supplied."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "9bdd3be4-b25b-4137-a335-0d0bc6620d4c",
