                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Aurora Core: read\nthe baseline and\nimprovement budget\nbeside the bypass."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
