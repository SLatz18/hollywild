                      {
                        "id": "40a051ff-e641-428c-a99c-2d5af74507ed",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Pip proposes\nWARMTH: first\nupgrades for homes\nand clinic rooms.",
                            "Rivet proposes\nINDUSTRY: first\nupgrades for shops\nthat make repairs",
                            "and wages. Nib\nproposes COMMONS:\nfirst upgrades for\nshared halls,",
                            "kitchens, and\npublic meeting\nrooms. Each\nincludes basic\nservice for",
                            "every district."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
