                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Pip proposes\nWARMTH: first\nupgrades for homes\nand clinic rooms.\nRivet proposes",
                            "INDUSTRY: first\nupgrades for shops\nthat make repairs\nand wages. Nib\nproposes COMMONS:",
                            "first upgrades for\nshared halls,\nkitchens, and\npublic meeting\nrooms. Each",
                            "includes basic\nservice for every\ndistrict."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
