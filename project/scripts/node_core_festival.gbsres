                        "args": {
                          "text": [
                            "Pip reads his\nspeech: The city\nis warmer. We know\nwhy. We know what",
                            "to check next.\nThank you for\ndoing your part.\nNib starts the",
                            "applause. Slush\njoins with his\ngloves on, then\nremoves them so it",
                            "sounds properly\nsincere."
                          ],
