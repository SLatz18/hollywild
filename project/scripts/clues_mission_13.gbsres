      "children": {
        "true": [
          {
            "id": "98775f33-4f0a-4167-a9ae-4e62b98b3e4b",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "c25ec80a-ac41-4ae5-a19b-ba53ca3dd69a",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "b99b45fe-2997-413f-a1ba-557f4d0b601f",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The easement\npermits city\nworkers to cross\nthe service hall\nfor pipe",
                      "repairs. It does\nnot grant public\nuse of bedrooms or\nkitchen. The",
                      "lodge owner keeps\nthose rooms. Nib\nreads the boundary\naloud,",
                      "unusually free of\ntheatrical\ngestures."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "905e59e5-a570-4509-a36c-5815838f730e",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
