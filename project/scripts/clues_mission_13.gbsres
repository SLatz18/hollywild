            "children": {
              "true": [
                {
                  "id": "8b86eb26-e090-43a9-aca6-e18bfb24406e",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "2dc0dabc-9752-419c-a289-692baa55a436",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Nib: The west\nsalon is called\nthe Winter Room\nbecause winter\nenters it. I used",
                      "to call that\nseasonal airflow.\nNow I am calling a\nroofer. The\njunction door is",
                      "behind the listing\nstand, and the\neasement is in the\ndisclosure."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "84ccd98d-b76b-480f-afc0-8a26eb3037fa",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "b5c987b9-f941-4ad1-a267-ef2e58da9d5b",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
