                  "args": {}
                },
                {
                  "id": "4d33c108-26f1-4567-a66d-4c21611f45aa",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Nib: The west\nsalon is called\nthe Winter Room\nbecause winter\nenters",
                      "it. I used to call\nthat seasonal\nairflow. Now I am\ncalling a roofer.",
                      "The junction door\nis behind the\nlisting stand, and\nthe easement is",
                      "in the disclosure."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "53841889-1044-4371-ad6b-96f39dbfc56b",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "18241c0c-444b-4999-af16-2b387e75b429",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
