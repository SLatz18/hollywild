                  "args": {}
                },
                {
                  "id": "2e6bdb9f-c2a9-43c2-a361-cb1eeee6c1cf",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which instruction\nbelongs in the\ncrew access\nnotice? Keep the\nservice right",
                      "effective without\nturning it into a\nclaim over private\nrooms. The tenant\nwill receive the",
                      "same notice as the\nbuilders. Nib\nwants her to know\nexactly where\nstrangers will",
                      "walk, not merely\nbe reassured that\neveryone means\nwell and carries\nclean boots."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "9d48bc96-40bb-41cd-abfc-39c77890fe7c",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
