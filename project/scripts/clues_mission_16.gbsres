        "true": [
          {
            "id": "9f9acea1-8142-497b-afd5-375e2a7c222b",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "b4a6bd5b-c448-4c93-ae84-c3312caea234",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "b7d165d7-449c-4db6-a591-ccfd81704c54",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The south chase\nhas two fitting\npositions.\nPosition A needs a\nnew",
                      "hole through a\nprivate kitchen\nwall. Position B\nuses the existing",
                      "service hatch and\ncosts one extra\nelbow joint. Both\nstay within the",
                      "pressure rating,\nand the city fund\ncovers either\njoint count. The",
                      "signed permission\ncovers only the\nexisting hatch.\nRivet says a",
                      "cheaper pipe does\nnot become cheaper\nif it buys an\nargument with a",
                      "tenant."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
