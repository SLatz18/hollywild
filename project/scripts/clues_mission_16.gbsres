                  "id": "b0363acb-7c22-4c5f-a92b-285346b98020",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which fitting\nposition is ready\nto authorize under\nthe agreement you",
                      "already hold?\nNeither option\nneeds your\npersonal money.\nThe decision",
                      "is about matching\nwork to its legal\nand physical\nboundary. Slush\ncan",
                      "grant a new\nkitchen-wall\nagreement later if\nthe tenant\nconsents, but",
                      "that permission\ndoes not exist now\nand should not be\nassumed."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
