                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which fitting\nposition is ready\nto authorize under\nthe agreement you\nalready hold?",
                      "Neither option\nneeds your\npersonal money.\nThe decision is\nabout matching",
                      "work to its legal\nand physical\nboundary. Slush\ncan grant a new\nkitchen-wall",
                      "agreement later if\nthe tenant\nconsents, but that\npermission does\nnot exist now and",
                      "should not be\nassumed."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
