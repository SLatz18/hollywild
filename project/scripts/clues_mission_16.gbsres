                  "id": "91324973-5279-4545-add5-c2d8fcd92073",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Survey: The north\nwall borders a\nbedroom. The east\nwall borders the\nkitchen. The south",
                      "service wall meets\nthe public pipe\nchase. Only the\nSOUTH path reaches\nthe chase entirely",
                      "within the\nrecorded service\neasement. The old\nhatch is already\nthere."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
