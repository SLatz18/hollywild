                            {
                              "id": "04788724-8216-4d01-acad-d5d6d1ab8de0",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The release\nchecklist requires\ntwo facts: public\nownership and a\ncleared repair",
                                  "charge. The\nsorting register\nproves ownership;\nthe paid repair\nline proves the",
                                  "charge cleared.\nThe storage\ndispute belongs on\na separate\naccount. A",
                                  "substitute form\noffers release if\nMoxie signs a\npersonal loan. She\ncould sign",
                                  "quickly, but it\nwould turn a\npublic paperwork",
                                  "error into her\nprivate debt. She\nputs the pen down."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
