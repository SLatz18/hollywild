                            {
                              "id": "1de12fe1-c639-454c-a262-2825803440fa",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The release\nchecklist requires\ntwo facts: public\nownership and a",
                                  "cleared repair\ncharge. The\nsorting register\nproves ownership;\nthe",
                                  "paid repair line\nproves the charge\ncleared. The\nstorage dispute",
                                  "belongs on a\nseparate account.\nA substitute form\noffers release if",
                                  "Moxie signs a\npersonal loan. She\ncould sign\nquickly, but it\nwould",
                                  "turn a public\npaperwork error\ninto her private\ndebt. She puts the",
                                  "pen down."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
