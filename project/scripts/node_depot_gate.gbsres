                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Frostwick Depot:\ninspect the\ntoolbox for the\ncarbon copy."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
