                      {
                        "id": "936e5d51-0cee-4aef-a3e5-366a88a15513",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The valve account\nshows twenty Coins\nfor inspection,\nalready paid by",
                            "Slush, and six for\nstorage, still\ndisputed. The city\nclaim slip",
                            "keeps ownership\npublic. The\nforeman remembers\nSlush paying\npromptly",
                            "when the pipe was\nmoved; he also\nremembers nobody\nagreeing to",
                            "private ownership.\nPip suggests\nthanking him for\nthe actual payment",
                            "without accepting\nthe extra claim.\nThe foreman hands\nyou a clean",
                            "tally card."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
