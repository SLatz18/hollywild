                  },
                  "children": {
                    "true": [
                      {
                        "id": "00cdc079-978c-407a-af0e-502a44d12c42",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Use the capacity\ncard to compare\nthe six-parcel\nload. How many\nfewer",
                            "trips does the\ncovered handcart\nneed than the roof\nharness? Your",
                            "route choice\nremains valid\neither way: the\nanswer tells Moxie\nhow to",
                            "staff it. A roof\nroute can make two\nhonest trips\nrather than claim",
                            "an overloaded\nharness is somehow\nmore festive."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
                      {
                        "id": "65c96410-9684-4bcc-a87d-accf02eaa415",
                        "command": "EVENT_MENU",
                        "args": {
                          "variable": "14",
                          "items": 3,
                          "layout": "menu",
                          "cancelOnLastOption": false,
                          "cancelOnB": true,
                          "option1": "ONE",
                          "option2": "TWO",
                          "option3": "THREE"
                        }
                      },
                      {
                        "id": "4ba6c4df-9883-477c-a93c-9f7afbe129f6",
                        "command": "EVENT_IF",
                        "args": {
