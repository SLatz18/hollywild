                                    "type": "variable",
                                    "value": "14"
                                  },
                                  "valueB": {
                                    "type": "number",
                                    "value": 0
                                  }
                                }
                              },
                              "children": {
                                "true": [
                                  {
                                    "id": "180db684-26a4-4a35-ae19-850245425c63",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Divide the six\nparcels by each\ncarrying limit,\nthen compare those",
                                        "trip counts. Do\nnot confuse the\nnumber of parcels\nwith the number of",
                                        "journeys."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
                                  }
                                ],
                                "false": []
                              }
                            }
                          ]
                        }
                      }
