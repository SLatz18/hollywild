                      {
                        "id": "61abce82-5faa-457f-a570-267f344f5125",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Moxie: I can take\nthe high line.\nThree turns,\nexcellent view,",
                            "terrible hat\ninsurance. The\ncovered route\nserves the clinic.\nIt is",
                            "longer but gives\nme someone to talk\nto besides weather\nvanes. Pick a",
                            "promise we can\nkeep."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
