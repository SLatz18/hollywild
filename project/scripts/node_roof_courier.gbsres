                                  {
                                    "id": "d2511085-d168-497a-abf5-a1d529a1661a",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Divide the six\nparcels by each\ncarrying limit,\nthen compare those",
                                        "trip counts. Do\nnot confuse the\nnumber of parcels\nwith the number of",
                                        "journeys."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
                                  }
                                ],
                                "false": []
                              }
                            }
                          ]
                        }
                      }
