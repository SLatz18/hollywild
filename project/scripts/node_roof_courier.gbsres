                      {
                        "id": "a94c4ebe-3384-4efb-ae6e-c8c0ee6b556f",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Moxie: I can take\nthe high line.\nThree turns,\nexcellent view,\nterrible hat",
                            "insurance. The\ncovered route\nserves the clinic.\nIt is longer but\ngives me someone",
                            "to talk to besides\nweather vanes.\nPick a promise we\ncan keep."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
