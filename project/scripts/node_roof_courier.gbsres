                              "args": {
                                "text": [
                                  "A Letter Never\nSent",
                                  "A draft\nresignation sits\nbeneath the\ncourier ledger. It\nbegins: I",
                                  "cannot promise the\nimpossible. The\nnext line reads: I\ncan promise to",
                                  "report what\nhappened. The rest\nof the page is\nblank. The draft\nwas",
                                  "kept, but no\nenvelope was ever\naddressed."
                                ],
