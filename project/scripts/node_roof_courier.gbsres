            "children": {
              "true": [
                {
                  "id": "5278cc13-5b98-4ed5-ae64-0f4b6318bfde",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: I can take\nthe high line.\nThree turns,\nexcellent view,",
                      "terrible hat\ninsurance. The\ncovered route\nserves the clinic.\nIt is",
                      "longer but gives\nme someone to talk\nto besides weather\nvanes. Pick a",
                      "promise we can\nkeep."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "d8eebf0e-bcbc-4b4a-af98-a6bc357ff89e",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 3
                    }
                  }
                },
                {
                  "id": "70a640af-1ac2-48d2-ac98-57b76593f6bb",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Candy Rooftops:\nchoose a route at\nthe weather vane."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                }
              ],
              "false": [
                {
                  "id": "dd5bdb99-bacc-4e17-a943-7a4bfec585a5",
