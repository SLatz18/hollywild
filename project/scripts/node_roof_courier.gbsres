                                "text": [
                                  "Candy Sorting:\nconfirm the route\nwith Moxie."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
