                                  {
                                    "id": "980205f3-e16c-40be-ae6d-be848d6f6409",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Three entries\nsurvive in the\nwatch log. At\nseven, the roof\nsent its",
                                        "alarm. At eight,\nAurora recorded\nthat alarm. At\nnine, Aurora",
                                        "attempted a reply,\nbut no roof\nreceipt was\nlogged. Dot points\nout",
                                        "that the first two\nentries show a\nsuccessful outward\npath. A later",
                                        "problem may affect\nthe return path\nwithout erasing\nthe earlier",
                                        "delivery. The\nwatch keeper wants\nhis crew cleared\nof a false",
                                        "accusation."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
