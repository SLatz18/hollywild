            "children": {
              "true": [
                {
                  "id": "389d0b7a-298a-4797-a698-370530c73be4",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie: I can take\nthe high line.\nThree turns,\nexcellent view,",
                      "terrible hat\ninsurance. The\ncovered route\nserves the clinic.\nIt is",
                      "longer but gives\nme someone to talk\nto besides weather\nvanes. Pick a",
                      "promise we can\nkeep."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "f014b985-3bc3-4421-addb-a5b9045c02f6",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 3
                    }
                  }
                },
                {
                  "id": "c65420fc-a751-4856-adf2-0b0f2bcf859b",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Candy Rooftops:\nchoose a route at\nthe weather vane."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                }
              ],
              "false": [
                {
