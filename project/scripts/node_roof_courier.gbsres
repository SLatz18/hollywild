                  },
                  "children": {
                    "true": [
                      {
                        "id": "4d0f4bb9-cdb9-415f-a104-342ec457dd1c",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Use the capacity\ncard to compare\nthe six-parcel\nload. How many\nfewer",
                            "trips does the\ncovered handcart\nneed than the roof\nharness? Your",
                            "route choice\nremains valid\neither way: the\nanswer tells Moxie\nhow to",
                            "staff it. A roof\nroute can make two\nhonest trips\nrather than claim",
                            "an overloaded\nharness is somehow\nmore festive."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
                      {
                        "id": "896d6b02-4604-4287-a19f-bfc0b0a05ce6",
                        "command": "EVENT_MENU",
                        "args": {
                          "variable": "14",
                          "items": 3,
                          "layout": "menu",
                          "cancelOnLastOption": false,
                          "cancelOnB": true,
                          "option1": "ONE",
                          "option2": "TWO",
                          "option3": "THREE"
                        }
                      },
                      {
                        "id": "ea00a8a6-7176-42e6-a5c9-8ae7c265140e",
                        "command": "EVENT_IF",
                        "args": {
                          "condition": {
