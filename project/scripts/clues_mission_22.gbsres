                  "args": {}
                },
                {
                  "id": "c05fe505-4be5-4243-aa43-46449ed59948",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Foreman signs: The\nheavy parts route\nstays clear. I\nhold the gate key\nand a spare at the",
                      "archive. If the\ngate freezes, call\nme; do not send\nthe load over the\nroof bridge. The",
                      "foreman draws a\nvery heavy arrow\nunder this."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "fd569e23-91a8-4b00-a6f1-30b9c95b0001",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
