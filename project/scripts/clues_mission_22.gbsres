                  "id": "05a3d287-fca9-429e-a4a0-9f0e54dc0f85",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Rivet signs:\nSpring checked,\nlimit set, seal\nsupply recorded.\nIf a reading",
                      "disagrees with the\nbucket, we\ninvestigate the\nreading before\nchanging the city.",
                      "She gives you the\nwooden spoon. It\nhas earned a place\nin the public tool\nrecord."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "4e27f967-ab96-4e7d-a9af-63198e85278a",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
