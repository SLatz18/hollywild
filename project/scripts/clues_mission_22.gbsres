            "args": {},
            "children": {
              "true": [
                {
                  "id": "40ab6eaa-8a45-4d02-a543-1c884a61ee77",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "d04508b6-1676-4910-a319-5dd5f5325184",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which branch\nshould receive the\nbackup copy in\nthis practice\npacket? Do not",
                      "resend every\nconfirmed delivery\njust to look busy.\nIdentify the\nunmatched sent",
                      "entry and use the\nassigned backup\nduty. Moxie puts\nher finger beside\nthe three",
                      "signatures and\nwaits for a\ndestination, not\nan instruction to\nride around until",
                      "somebody feels\nreassured."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "b81d5294-d4c8-4a90-a693-96bf49c1264d",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
