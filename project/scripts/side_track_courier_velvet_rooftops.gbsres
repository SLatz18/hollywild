                  "args": {
                    "text": [
                      "Extremely Special\nDelivery",
                      "A courier named\nFig has opened a\ndelivery firm for\nthings other firms\npolitely leave",
                      "behind. His first\nclient is a\nceremonial\npudding. Its rider\ndemands legroom.",
                      "Begin at Frostwick\nDepot."
                    ],
