                {
                  "id": "008867b2-3ab7-4a2f-a673-480369265f64",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: Aurora did\nnot vanish. It was\nfiled under\nSeasonal Mood.\nThat",
                      "drawer holds a tax\nappeal from a\nsnowman. Search\nthe catalog for",
                      "SERVICE. The\npublic repair\nledger has a\nsquare seal;\nprivate sales",
                      "use a crown."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "d435fe09-cb59-480e-a642-a87a3e91a99a",
                  "command": "EVENT_SET_VALUE",
