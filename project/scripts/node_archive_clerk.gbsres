                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Frostwick Archive:\ncompare the dated\nindex notes at the\nblueprint table."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
