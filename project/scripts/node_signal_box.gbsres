            "children": {
              "true": [
                {
                  "id": "2ec41f93-7d9d-462c-a32f-6aa5213601d4",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Log: Roof alarm\nreceived. Station\nreply sent. Shared\nrelay froze",
                      "before the reply\nleft. No second\npath existed. The\noperator stayed",
                      "to hand carry the\nreply, but the\ngate crew had\nalready withdrawn.",
                      "Nobody could\nconfirm whether\nthe message\narrived."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "bfbbf1ba-35c4-4640-a69f-b032627e7602",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 1
                    }
                  }
                },
                {
                  "id": "12032711-a814-4dfe-a981-dc5ed37d2b6b",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Aurora Signal:\nstudy the\ntwo-fault map\ndrill with the\nclerk."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                }
              ],
              "false": [
                {
