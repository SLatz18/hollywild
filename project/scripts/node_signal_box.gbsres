                  },
                  "children": {
                    "true": [
                      {
                        "id": "768a048a-0f39-416c-a759-72bf3fc8a87c",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "For this two-fault\ndrill, which route\ncan still carry\nthe reply? Use",
                            "the map topology\nrather than\nassuming any\ncourier path must\nbe",
                            "independent. Moxie\nis willing to walk\nthe longer foot\nroute, but",
                            "wants the planner\nto name why it is\nneeded. Dot keeps\nboth blocked",
                            "components marked\nso nobody forgets\nthe second\nconstraint while",
                            "solving the first."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
                      {
                        "id": "b98f3639-4238-4f38-ac0e-0eb77aef4a2e",
                        "command": "EVENT_MENU",
                        "args": {
                          "variable": "14",
                          "items": 3,
                          "layout": "menu",
                          "cancelOnLastOption": false,
                          "cancelOnB": true,
                          "option1": "A",
                          "option2": "B",
                          "option3": "C"
                        }
                      },
                      {
                        "id": "65ed3744-3d01-4b83-af3d-ffadad7d0da3",
                        "command": "EVENT_IF",
                        "args": {
