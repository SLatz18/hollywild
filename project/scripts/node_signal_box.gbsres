            "children": {
              "true": [
                {
                  "id": "263183f0-3274-4940-a28c-5b149b3dd267",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Log: Roof alarm\nreceived. Station\nreply sent. Shared\nrelay froze",
                      "before the reply\nleft. No second\npath existed. The\noperator stayed",
                      "to hand carry the\nreply, but the\ngate crew had\nalready withdrawn.",
                      "Nobody could\nconfirm whether\nthe message\narrived."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "45d5de23-053a-4a72-aecb-3105ba144b2f",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 1
                    }
                  }
                },
                {
                  "id": "9dd9bfb6-c784-4910-aa65-3501de2bee09",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Aurora Signal:\nstudy the\ntwo-fault map\ndrill with the\nclerk."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                }
              ],
              "false": [
                {
                  "id": "e1ef27ba-429c-44df-a02b-8921a994b29d",
                  "command": "EVENT_IF",
                  "args": {
