                      {
                        "id": "57f9be95-22e9-4a7b-a1c0-b10aa53947f5",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Log: Roof alarm\nreceived. Station\nreply sent. Shared\nrelay froze before\nthe reply left. No",
                            "second path\nexisted. The\noperator stayed to\nhand carry the\nreply, but the",
                            "gate crew had\nalready withdrawn.\nNobody could",
                            "confirm whether\nthe message\narrived."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
