                                    "id": "b3e1eb34-a624-4bac-a101-770665efc94e",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Trace each path\nagainst both\nmarked failures. A\nroute is\nindependent",
                                        "only if it avoids\nevery component\nthe drill has\ntaken out."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
