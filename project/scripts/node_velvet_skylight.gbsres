                {
                  "id": "4cf2d4d7-b604-4bdb-a5e7-066378038e3a",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush offers the\nfull inspection\nfile. You may\nREVIEW it together\nat",
                      "his desk or\nrequest a PUBLIC\nreview with the\nclerk. Both\npreserve",
                      "his private tenant\nnames. Choose the\ntrust process for\nthe",
                      "negotiation."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "46e9a8a3-bff1-4b09-ac01-a9a484742229",
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "14",
                    "items": 2,
                    "layout": "menu",
                    "cancelOnLastOption": false,
                    "cancelOnB": true,
                    "option1": "REVIEW",
                    "option2": "PUBLIC"
                  }
                },
