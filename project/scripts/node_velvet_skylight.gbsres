                {
                  "id": "2a119c74-573c-417f-aaf9-d0b248c27270",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush offers the\nfull inspection\nfile. You may\nREVIEW it together\nat",
                      "his desk or\nrequest a PUBLIC\nreview with the\nclerk. Both\npreserve",
                      "his private tenant\nnames. Choose the\ntrust process for\nthe",
                      "negotiation."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "57b97603-6a48-488b-a904-876d0e3e8399",
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "14",
                    "items": 2,
                    "layout": "menu",
                    "cancelOnLastOption": false,
                    "cancelOnB": true,
                    "option1": "REVIEW",
                    "option2": "PUBLIC"
                  }
                },
