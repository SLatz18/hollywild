                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "You agree to read\nthe file with\nSlush before\npublishing\nfindings. He",
                            "sets down the\numbrella, an oddly\nserious gesture.\nDot keeps an",
                            "independent copy\nof every test."
                          ],
