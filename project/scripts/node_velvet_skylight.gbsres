                            {
                              "id": "b2c52b37-e55c-4d52-a290-948f1212b23b",
                              "command": "EVENT_GROUP",
                              "args": {},
                              "children": {
                                "true": [
                                  {
                                    "id": "6de6ba9c-e057-4271-afd7-6b53359e4638",
