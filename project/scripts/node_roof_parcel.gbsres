                        "id": "84a2e551-cfac-4ac7-a31c-891a7daa9de8",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "A waxed parcel\nholds the watch\nlog, kept dry\nbeneath the chest\nlid.",
                            "The alarm was\nsent. The\nacknowledgment\nnever came back.\nDot reads",
                            "this twice, then\nasks you to carry\nthe original while\nshe keeps an",
                            "exact copy."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
