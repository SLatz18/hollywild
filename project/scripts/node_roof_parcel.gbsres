                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "The Dry Box",
                                  "The parcel chest\nhas three layers\nof waterproof\ncloth and a very",
                                  "modest lock. A\nlabel explains\nthat the contents\nare public\nrecords.",
                                  "The lock keeps\nwind out rather\nthan people.\nWhoever last\nchecked the",
                                  "chest left a clean\ncloth for the next\nreader."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
