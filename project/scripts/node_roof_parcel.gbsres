                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "What should the\nroof keeper do\nfirst with a\nreport that cannot\ndistinguish the",
                                  "two active\nsignals? The\nwritten received\ncard is available\nbeside the lamp.",
                                  "No warning is\ncurrently\nconfirmed. Choose\na check that can\nestablish what was",
                                  "actually sent\nbefore calling\neither receipt or\na courier request.\nThe keeper wants a",
                                  "rule that still\nworks on a misty\nnight."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
