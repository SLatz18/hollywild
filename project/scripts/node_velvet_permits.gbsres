                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Permit note: A\nprivate owner may\nmaintain the\njunction but\ncannot shut public",
                                  "branches to\nreserve heat for a\nnew estate. Slush\nsigns beneath it.\nI know what the",
                                  "paper says, he\ntells Nib. I need\nto know the\nmachine will\nagree."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
