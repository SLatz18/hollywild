            "children": {
              "true": [
                {
                  "id": "9ed347b7-1dda-4597-afd3-5520723dbb1e",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The review file\nhas four fields:\nrepair amount,\nwork date, tenant",
                      "name, and medical\nnote. The public\nfund needs the\namount and work",
                      "date to verify the\nrepair. Neither a\ntenant name nor a\nmedical note",
                      "is needed for that\ncheck. Slush fears\nthe review will\nmake his",
                      "residents into\nexhibits. Dot says\naccountability for\nmoney does not",
                      "require exposing\ndetails that\ncannot prove how a\nroof was repaired."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "5719126c-4fe2-4d02-a79d-4ba919145153",
                  "command": "EVENT_SET_VALUE",
                  "args": {
                    "variable": "44",
                    "value": {
                      "type": "number",
                      "value": 2
                    }
                  }
                },
                {
                  "id": "b83b1c36-3960-4cdf-a674-c445241e15d1",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Velvet Rooftops:\nexamine the\ngreenhouse survey\nbook."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                }
              ],
