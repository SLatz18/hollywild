      "children": {
        "true": [
          {
            "id": "4376e4c2-672c-47e9-a5e4-47a604f3c490",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "41f4158a-abf4-4d14-a811-9a10b6efefda",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "195f5ba4-57e0-488d-a2b7-d53087438f58",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot: The wire path\nruns roof, relay,\nstation. A courier\npath can run\nstation, depot,",
                      "roof. They share\nno relay. A second\nwire through the\nsame frozen box\nwould have the",
                      "same fault. A new\ncolor is not a new\npath."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "ef2ad0e2-ea9b-4cb6-af08-8c5b383f739f",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
