                {
                  "id": "0a8216df-3037-409a-aa8b-faa1cfe869da",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "c5889008-4a52-465d-aa8f-2d0d76529fe6",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: I will log\nthe sent message\nand ask for a\nreceived mark. If",
                      "no mark returns,\nMoxie carries a\ncopy. We will not\ncall silence",
                      "agreement. Pip\nwrites that\nsentence at the\ntop, then asks\npermission",
                      "to keep it there."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "2c24f00b-c1c0-4601-a72d-40ce30e8af89",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
