                  "args": {}
                },
                {
                  "id": "6481d835-ff5f-4ffb-ad8c-ec1fd4866d51",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: I will log\nthe sent message\nand ask for a\nreceived mark. If\nno mark returns,",
                      "Moxie carries a\ncopy. We will not\ncall silence\nagreement. Pip\nwrites that",
                      "sentence at the\ntop, then asks\npermission to keep\nit there."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "bcce5647-e32f-4f6c-a673-b7a4bda81299",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
