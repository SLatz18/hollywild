      },
      "children": {
        "true": [
          {
            "id": "fb4c5343-be81-4de7-a9bc-d2a9e5438e73",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "2107736b-a67c-48a7-aa50-940f03294a6b",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "696e9b11-07ac-488f-ab57-e829a7a9f8fb",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "For this two-fault\ndrill, which route\ncan still carry\nthe reply? Use",
                      "the map topology\nrather than\nassuming any\ncourier path must\nbe",
                      "independent. Moxie\nis willing to walk\nthe longer foot\nroute, but",
                      "wants the planner\nto name why it is\nneeded. Dot keeps\nboth blocked",
                      "components marked\nso nobody forgets\nthe second\nconstraint while",
                      "solving the first."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "8e480a17-cc3d-4c55-a31e-27f55bd407ad",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
