        }
      },
      "children": {
        "true": [
          {
            "id": "70e30cba-a89f-4d75-a54a-c223c7f51bfd",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "40823f5e-be27-441a-ae04-30b467546791",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "6de62133-1c8c-4d1f-a31b-91800c889aae",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "For this two-fault\ndrill, which route\ncan still carry\nthe reply? Use the\nmap topology",
                      "rather than\nassuming any\ncourier path must\nbe independent.\nMoxie is willing",
                      "to walk the longer\nfoot route, but\nwants the planner\nto name why it is\nneeded. Dot keeps",
                      "both blocked\ncomponents marked\nso nobody forgets",
                      "the second\nconstraint while\nsolving the first."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "571dca17-80e7-4dde-a8af-0d2b4fb75b51",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
