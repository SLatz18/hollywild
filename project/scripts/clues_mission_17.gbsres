            "id": "19b795ca-6e55-4c5f-a6fc-6f8b5f78e780",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "ddb6e2bf-45d3-4c93-a99b-91e5304a3dd5",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "2f246a6f-57e2-46cc-a279-cb07f574a63b",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "For the EARLIER\nrelay-only\nfailure, before\nthe gate fault was\nadded,",
                      "which backup\navoided the failed\nrelay? The next\ncheck will",
                      "separately ask you\nto solve the\ntwo-fault drill.\nKeep the two cases",
                      "distinct in the\nlog."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "906e31d1-71dc-43f6-a9cd-c9d0ede3e09a",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "d68f1a0a-8565-43b6-a09b-6247b1e608b4",
      "command": "EVENT_IF",
      "args": {
        "condition": {
