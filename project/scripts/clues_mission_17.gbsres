      "children": {
        "true": [
          {
            "id": "cdebb95c-10d2-4eac-a67f-aba8d2575887",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "21628efe-82cd-4910-a4ee-e0c51a3b5543",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "a1f665a7-bf99-4a59-a93e-5fbec8e7917d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot: The wire path\nruns roof, relay,\nstation. A courier\npath can run",
                      "station, depot,\nroof. They share\nno relay. A second\nwire through the",
                      "same frozen box\nwould have the\nsame fault. A new\ncolor is not a new",
                      "path."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "4c2bbdc7-9a08-4f17-a244-c1a606bf7629",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
