                  "args": {}
                },
                {
                  "id": "8e86d4bb-09be-499b-a814-b4c8037c77c5",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Log: Roof alarm\nreceived. Station\nreply sent. Shared\nrelay froze before\nthe reply left. No",
                      "second path\nexisted. The\noperator stayed to\nhand carry the\nreply, but the",
                      "gate crew had\nalready withdrawn.\nNobody could",
                      "confirm whether\nthe message\narrived."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "d4954e5e-4418-4495-ab20-700a3e440a27",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "79c81883-7238-4f4b-ab24-df3e448d05b9",
      "command": "EVENT_IF",
      "args": {
        "condition": {
