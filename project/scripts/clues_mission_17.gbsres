          {
            "id": "9d90b851-cba8-4224-a0bf-3f4356c18ac7",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "2d8adcf5-f697-4127-a710-6dae92bd37be",
