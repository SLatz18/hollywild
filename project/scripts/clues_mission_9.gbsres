            "command": "EVENT_TEXT",
            "args": {
              "text": [
                "Which regulator\npart supplies the\nclosing action\nwhen power fails?"
              ],
              "avatarId": "",
              "minHeight": 4,
              "maxHeight": 7,
              "position": "bottom",
              "closeWhen": "key",
              "closeButton": "a"
