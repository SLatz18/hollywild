                            {
                              "id": "02e80291-1ac2-4e16-a7f6-0ed282f1c72b",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Dot marks a second\npaper fault: the\ndepot gate is\nblocked while the\nrelay remains",
                                  "frozen. Courier\nroute A crosses\nthat gate. Foot\nroute B goes\nthrough the",
                                  "archive service\nlane and touches\nneither gate nor\nrelay. Wire route\nC uses the frozen",
                                  "relay. These are\ntest marks only;\nno public doorway\nis locked. Moxie\nasks for a backup",
                                  "that survives both\nfaults, not just\nthe one that made\nyesterday famous."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
