                                        {
                                          "id": "2bdf7535-0b93-41f6-a599-463fcef8ddab",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Which combined\nresponse applies\nthe demonstrated\nsafeguards? HOLD",
                                              "means shut every\nbranch and wait\nfor a perfect\nsystem. PUSH means",
                                              "increase pressure\nand assume the\nmessage arrived.\nSERVE means keep",
                                              "clear branches at\nsafe service,\nretain lodge\nisolation, and\nsend the",
                                              "backup copy by the\navailable foot\nroute. Choose the\nplan you can",
                                              "explain to the\nwaiting residents."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
                                            "closeWhen": "key",
                                            "closeButton": "a"
                                          }
