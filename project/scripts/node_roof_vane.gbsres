                {
                  "id": "ff120d7b-fa5f-424c-a33d-c4acac07d5dd",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The vane bears two\nservice marks:\nHIGH for the roof\ncircuit, COVER",
                      "for the sheltered\nclinic circuit.\nThis sets your\ndelivery plan.\nBoth",
                      "routes stay\nwalkable, and the\ncity will remember\nwhich promise you",
                      "made."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "ccfd87a6-e443-48e4-aa97-ba7a7d64e262",
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "14",
                    "items": 2,
                    "layout": "menu",
                    "cancelOnLastOption": false,
                    "cancelOnB": true,
                    "option1": "HIGH",
                    "option2": "COVER"
                  }
                },
