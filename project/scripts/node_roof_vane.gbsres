                {
                  "id": "aba8c18b-38d1-4a80-a9b3-3ea838a23a6a",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The vane bears two\nservice marks:\nHIGH for the roof\ncircuit, COVER",
                      "for the sheltered\nclinic circuit.\nThis sets your\ndelivery plan.\nBoth",
                      "routes stay\nwalkable, and the\ncity will remember\nwhich promise you",
                      "made."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "633133ac-5f0a-4c72-a9bc-832f102767d2",
                  "command": "EVENT_MENU",
                  "args": {
                    "variable": "14",
                    "items": 2,
                    "layout": "menu",
                    "cancelOnLastOption": false,
                    "cancelOnB": true,
                    "option1": "HIGH",
                    "option2": "COVER"
                  }
                },
