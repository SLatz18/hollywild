                              "children": {
                                "true": [
                                  {
                                    "id": "d0664c17-91e2-4512-ab86-962c497b1ad3",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Slush checks the\nline with his own\nruler. The second\ndoor does not",
                                        "remove his wheel.\nIt prevents his\nwheel from being\nthe only door. He",
                                        "asks Dot to\nexplain what fails\nif the bypass\nfreezes too."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
                                  },
                                  {
                                    "id": "631a730f-ed24-406f-a013-557942d68488",
                                    "command": "EVENT_IF",
                                    "args": {
                                      "condition": {
                                        "type": "eq",
                                        "valueA": {
                                          "type": "variable",
                                          "value": "48"
                                        },
                                        "valueB": {
                                          "type": "number",
                                          "value": 1
                                        }
                                      }
                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "3d267df5-5ea2-4c03-a483-ef0abf6f315d",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Slush: We read the\nfile together.\nYour plan names\nthe same faults I",
                                              "did and proposes\nan answer I can\ncheck. That earns\na trial, not",
                                              "blind faith."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
                                            "closeWhen": "key",
                                            "closeButton": "a"
                                          }
                                        }
                                      ],
                                      "false": []
                                    }
                                  },
                                  {
                                    "id": "14c7e028-92b6-44ec-a1c0-1c89b2a00f9a",
                                    "command": "EVENT_IF",
                                    "args": {
                                      "condition": {
                                        "type": "eq",
                                        "valueA": {
                                          "type": "variable",
                                          "value": "48"
                                        },
                                        "valueB": {
                                          "type": "number",
                                          "value": 2
                                        }
                                      }
                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "18d6a9e4-d8e0-41a9-aec1-c0edfc483037",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Slush: The clerk\npublished my costs\naccurately. I\ndisliked the",
                                              "process. I have\nless reason to\ndistrust its\ndrawing. Let the\nwitness",
                                              "keep the test log."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
                                            "closeWhen": "key",
                                            "closeButton": "a"
                                          }
                                        }
                                      ],
