                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "9ed307fc-4090-42ae-a3f8-0273f5a61a3f",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Slush: The clerk\npublished my costs\naccurately. I\ndisliked the",
                                              "process. I have\nless reason to\ndistrust its\ndrawing. Let the\nwitness",
                                              "keep the test log."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
                                            "closeWhen": "key",
