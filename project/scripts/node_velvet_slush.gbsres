                              "id": "9b0fb128-e51d-43e1-a0c3-26d5865f9b42",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Slush: My father\nran the east\ngreenhouse. One\nfrozen reply wire,\none unopened",
                                  "valve, and a\nseason of\nseedlings lost.\nThe city sent\ncondolences",
                                  "printed on very\nwarm paper. I\nbought the lodge",
                                  "to stop waiting\nfor permission to\nkeep people safe."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
