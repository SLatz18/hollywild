                                  {
                                    "id": "b5d5eb8f-0f93-46f4-a39a-d6b10e533ca7",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Slush checks the\nline with his own\nruler. The second\ndoor does not",
                                        "remove his wheel.\nIt prevents his\nwheel from being\nthe only door. He",
                                        "asks Dot to\nexplain what fails\nif the bypass\nfreezes too."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
                                      "position": "bottom",
                                      "closeWhen": "key",
                                      "closeButton": "a"
                                    }
                                  },
                                  {
                                    "id": "2231d633-dc11-4f4d-a6ca-1a529707673d",
                                    "command": "EVENT_IF",
                                    "args": {
                                      "condition": {
                                        "type": "eq",
