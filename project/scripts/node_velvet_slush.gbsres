                        "id": "36e4d564-3d4b-4952-a3c2-b2ad0c394f49",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Velvet Rooftops:\ncompare public\nreview fields with\nthe privacy note."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
