                        "id": "ee3a16b5-c04f-4e79-a6d7-8c1c98268089",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Velvet Rooftops:\ncompare public\nreview fields with\nthe privacy note."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
