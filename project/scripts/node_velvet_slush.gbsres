                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Velvet Rooftops:\ncompare the permit\npages at the\npermit board."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
