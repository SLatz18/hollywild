                                          "type": "variable",
                                          "value": "48"
                                        },
                                        "valueB": {
                                          "type": "number",
                                          "value": 1
                                        }
                                      }
                                    },
                                    "children": {
                                      "true": [
                                        {
                                          "id": "cb469d81-db9f-4276-a1b5-64da531c0966",
                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Slush: We read the\nfile together.\nYour plan names\nthe same faults I",
                                              "did and proposes\nan answer I can\ncheck. That earns\na trial, not",
                                              "blind faith."
                                            ],
                                            "avatarId": "",
                                            "minHeight": 4,
                                            "maxHeight": 7,
                                            "position": "bottom",
                                            "closeWhen": "key",
