                        "id": "d8d15416-89cb-4e4a-a0cf-9ff0b2ebcc7f",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The Address That\nMoved",
                            "One address card\nreads: Mrs. Elm,\nformerly third\nfloor, now ground",
                            "floor by the ramp.\nHer mail followed\nher before the\nofficial map",
                            "did. The couriers\nkeep the\ncorrection pinned\nup until the city",
                            "prints a new map.\nAccuracy sometimes\nstarts on a scrap."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
