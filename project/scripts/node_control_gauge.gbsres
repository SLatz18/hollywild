                                          "command": "EVENT_TEXT",
                                          "args": {
                                            "text": [
                                              "Look for the\nobservation that\ndisagrees with two\nseparately checked",
                                              "facts. Changing a\nverified reference\nor forcing the\nmachine to match",
                                              "a display would\nhide the\ndisagreement."
                                            ],
