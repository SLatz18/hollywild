                      {
                        "id": "7b906ccc-e504-4683-a3e7-fa8e94edc9ef",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Dot turns the pump\noff. The line is\nopen, the bucket\nis empty, and",
                            "the needle still\nreads TWO. She\nrecords all three\nfacts before",
                            "touching the\nscrew. Rivet says\na neat notebook is\nless expensive",
                            "than a neat\nexplanation\nafterward."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
                      {
                        "id": "bbf85945-93ff-4fb2-a041-bb0ba85f470c",
