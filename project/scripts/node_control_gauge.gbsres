                      {
                        "id": "5a37c1da-4cec-4410-aab8-418290adfb80",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "A Confident Needle",
                            "The gauge face\ncarries an old\nslogan: ALWAYS\nCERTAIN. Someone\nhas",
                            "covered CERTAIN\nwith CHECKED.\nRivet recognizes\nDot's handwriting\nand",
                            "says nothing. Dot\nrecognizes Rivet's\nsilence as\npermission. The",
                            "crossed out word\nremains visible\nbeneath the paper,\nwhich feels like",
                            "the point."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      }
                    ],
                    "false": [
                      {
