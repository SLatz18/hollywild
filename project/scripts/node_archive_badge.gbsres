                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The badge is warm\nfrom the clerk\nholding it. Its\nowner was the last",
                            "city pipe walker.\nA penciled note\nreads: If anyone\nsays the network",
                            "is dead, ask who\nstopped checking\nthe valves."
                          ],
