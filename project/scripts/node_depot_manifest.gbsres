                              "id": "d0c0230d-6093-46af-acaa-fbb287c860e5",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Which packet\nsatisfies the two\nrelease conditions\nwithout making",
                                  "Moxie personally\nliable? The clerk\ncan attach more\nthan one",
                                  "document. Do not\nsolve a missing\nproof by inventing\na new borrower.",
                                  "Moxie says she\nwill wait while\nyou get it right;\nthe sled belongs\nto",
                                  "the city, and so\ndoes the duty to\nkeep its records\nstraight."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
