                        "args": {
                          "text": [
                            "Manifest: Vehicle\nloan: none. Repair\ndebt: cleared.\nStorage claim:",
                            "disputed. Release\nrequires the\nmunicipal owner\nmark, a square.\nThe",
                            "crown stamp would\ntransfer a private\nvehicle, which\nthis sled has",
                            "never been."
                          ],
