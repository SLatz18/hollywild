        "true": [
          {
            "id": "007f7920-d536-46d9-a3e3-40efbcb1f64f",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "c148f37f-201f-49b8-a37f-6159d4b17e97",
