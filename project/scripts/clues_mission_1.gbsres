      "children": {
        "true": [
          {
            "id": "b1b0ddc9-9ae4-43db-a7db-ecea16f66fb6",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "8bc767a5-6bbe-4863-a304-b5f04f16f018",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "23eb1352-c02f-4fb1-ae64-7aaebb65b6a1",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The catalog has\nthree seal marks.\nWhich mark\nidentifies the\npublic repair",
                      "ledger? Use the\nfiling rule the\nclerk gave you,",
                      "rather than the\nmost decorative\ncover."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
