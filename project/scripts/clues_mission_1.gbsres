      "children": {
        "true": [
          {
            "id": "0f4aea6e-311e-4c8d-a167-ad694436265d",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "e4e3c69c-2b97-40c6-ac39-34b7c28426e8",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "f21c333d-d0c2-4322-a0dd-a95b03e65190",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The badge is warm\nfrom the clerk\nholding it. Its\nowner was the last",
                      "city pipe walker.\nA penciled note\nreads: If anyone\nsays the network",
                      "is dead, ask who\nstopped checking\nthe valves."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "97ce549a-d160-4a3b-a92a-7ba6dca307ce",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "4cc6acc4-bc28-4194-aacf-a2bf8f7ffdf6",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 4
