        "true": [
          {
            "id": "328f9deb-2b90-42a3-a419-e55e315ba9f0",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "825b46a3-0f7e-496a-aaac-804ebc323207",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "3d2a1eb6-f094-4f19-a4fd-a27284a02b75",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: Aurora did\nnot vanish. It was\nfiled under\nSeasonal Mood.\nThat",
                      "drawer holds a tax\nappeal from a\nsnowman. Search\nthe catalog for",
                      "SERVICE. The\npublic repair\nledger has a\nsquare seal;\nprivate sales",
                      "use a crown."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "88bfd203-07e7-4de5-a86f-209d2b977ef7",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "b8ad39c1-b952-4b36-aac8-6130866ce166",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "3942a010-209a-4c2e-a90a-5143945e9d9d",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "4f95f7fa-40da-4b6b-aea0-9721a59e96b2",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "4b25b684-b144-483d-a822-eb321a2c3935",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The table holds\nthree index notes.\nDecember: repairs\ncomplete,",
                      "signed by the\nengineer. January:\nsale proposed,\nunsigned.\nFebruary:",
                      "ownership\nunchanged until a\ndeed is signed and\nentered. A\nresident",
                      "named Mara needs\nto know who must\nfix her leaking\nstair pipe. She",
                      "has already been\nsent between three\ndesks. The clerk\nsays a later",
                      "date does not make\nan unsigned\nproposal into a\ncompleted\ntransfer."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "551090a1-0fa2-48aa-ac0e-f247ec679b54",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "c7003b2c-ad62-48c5-a565-ea2de2d42e8c",
      "command": "EVENT_IF",
      "args": {
