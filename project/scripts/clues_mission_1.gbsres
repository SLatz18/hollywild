                {
                  "id": "d53ce4d5-014f-49f4-aeb2-c9fd571d8c5b",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "434f8fa4-abe5-4c82-aacc-4e3b25026792",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Foreman: I knew\nthat coat. Your\naunt carried soup\nin the left pocket",
                      "and drawings in\nthe right.\nSometimes the\ndrawings smelled\nof leek.",
                      "She left a\nmanifest here, and\na warning against\npeople selling",
                      "perfect winters."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "690bf028-4045-4d33-a005-782182d3d4eb",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
