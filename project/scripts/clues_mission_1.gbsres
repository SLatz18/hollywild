      },
      "children": {
        "true": [
          {
            "id": "5839079b-0298-4023-a0fc-a185eafa9d6d",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "4acaabc1-33b4-4abc-ad2c-4bc1034e35af",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "b4fa9885-10a9-4407-a528-40548f19d403",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The catalog has\nthree seal marks.\nWhich mark\nidentifies the\npublic",
                      "repair ledger? Use\nthe filing rule\nthe clerk gave\nyou, rather than",
                      "the most\ndecorative cover."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "57cdfb65-d428-4655-a4e0-cf2bc229aee3",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
