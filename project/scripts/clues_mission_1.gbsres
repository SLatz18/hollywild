                  "args": {}
                },
                {
                  "id": "2c56efaa-29d7-46b6-a950-38080520c3f2",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: Aurora did\nnot vanish. It was\nfiled under\nSeasonal Mood.\nThat drawer holds",
                      "a tax appeal from\na snowman. Search\nthe catalog for\nSERVICE. The\npublic repair",
                      "ledger has a\nsquare seal;\nprivate sales use\na crown."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "408d47c4-5c2c-4b27-a718-a0db770b98be",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "535dda61-eefa-4289-afe5-082f3b557735",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "d4ae0dbb-639e-437b-a165-87e94c934cda",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "6773ff84-d40d-46ab-a59c-cc40693b5e1b",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "3ade5b19-b29f-4294-a69a-cb37224bcbb3",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The table holds\nthree index notes.\nDecember: repairs\ncomplete, signed\nby the engineer.",
                      "January: sale\nproposed,\nunsigned.\nFebruary:\nownership",
                      "unchanged until a\ndeed is signed and\nentered. A\nresident named\nMara needs to know",
                      "who must fix her\nleaking stair\npipe. She has\nalready been sent\nbetween three",
                      "desks. The clerk\nsays a later date\ndoes not make an",
                      "unsigned proposal\ninto a completed\ntransfer."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "0114734e-7e6e-401e-a420-3d92e16de178",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
