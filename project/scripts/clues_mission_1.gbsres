                  "args": {}
                },
                {
                  "id": "b87e25ca-59e4-4a4f-a9b0-7b68f75b4496",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The badge is warm\nfrom the clerk\nholding it. Its\nowner was the last\ncity pipe walker.",
                      "A penciled note\nreads: If anyone\nsays the network",
                      "is dead, ask who\nstopped checking\nthe valves."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "5b53e87d-55b9-48cc-a5fd-2afbfb9f6419",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "bb78de84-faff-44ce-a07f-9aae34934a16",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
