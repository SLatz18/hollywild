                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Four branches feed\ninto one iron\nthroat. A polished\nbrass wheel closes\nall four together.",
                            "Dot sees fresh\ngrease on the\nwheel. Someone has\ncared for it.\nSomeone has also",
                            "made every branch\ndepend on a single\nmoving piece."
                          ],
