      "children": {
        "true": [
          {
            "id": "ffcaa356-63c9-4c9e-ac44-88c3562e207a",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "2173a503-9b4f-4ba3-adb5-c4131042f688",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "03e9ba29-ee26-4ff9-a922-6bf20e0fe578",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which recipe plan\nmeets all three\nconstraints:\nexactly three\nseals,",
                      "no partial batch,\nand at least two\nstock left? Read\nthe output as",
                      "carefully as the\ninput. Two small\nbatches may look\neconomical until",
                      "you count what\nthey make. The\nother crew has\nalready planned a",
                      "repair around the\nstock you promised\nnot to consume."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "76bf3cc1-ca2c-4c6b-ad16-c79c821b7fc8",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
