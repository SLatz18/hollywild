        "true": [
          {
            "id": "79911541-3e66-4d36-ab04-1488835026fa",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "78fca5f7-707e-444b-afec-27faab939c2b",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "9e8209f9-285f-4227-a092-0b15985f789f",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot: One standard\nbatch makes two\nseals from two\nunits. One repair\ntakes one seal.",
                      "The next\ninspection needs\ntwo seals. So a\nsingle batch\ncovers that",
                      "inspection\nexactly. A second\nbatch is a buffer,\nnot a requirement\nwe should hide."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "1c8a24a3-2d4c-4f66-acfb-8ff13b218475",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
