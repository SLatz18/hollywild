        }
      },
      "children": {
        "true": [
          {
            "id": "5d79178c-3366-47a4-a06c-ac936e908b70",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "29721db6-932a-4ce3-a3fa-e0d5340962dd",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "06a5cdff-a66b-47ae-a262-535db4c92f52",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "For the original\nstandard\ninspection, use\nDot two-seal\nrequirement and",
                      "the standard\ntwo-seal batch,\nnot the different\npractice recipes.\nHow many standard",
                      "batches cover that\ninspection exactly\nbefore adding a\nbuffer?"
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "4a9374d3-a270-4e3c-ad9b-820199db961b",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
