            "children": {
              "true": [
                {
                  "id": "5ee81cfc-2fc2-4b0c-a097-b330bd70a03e",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "e424bae2-9d75-4dc7-aa76-0f2ed870ccd9",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The spring closes\nthe valve with a\nsmall click. Rivet\nrepeats the test\nwith the power",
                      "disconnected. The\nsame click\nanswers. Pip says\nit sounds less\ngrand than",
                      "expected. Rivet\nsays good safety\nequipment often\nhas excellent\nmanners."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "6a4f2fae-a0f4-486f-a141-eb9d5c88961e",
                  "command": "EVENT_SHOW_SPRITES",
