    {
      "id": "22f16812-fa16-405c-a72d-d09069433473",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "c6cc6aa6-91c4-4043-a994-4872b1e54be2",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "1e1a2849-b111-4b33-a2bc-ef6d775f9a60",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "8b7665d4-b553-49c6-af36-38cc82b70e0f",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Rivet presents a\nDIFFERENT practice\norder, separate\nfrom the two-seal\nstandard",
                      "inspection. This\norder needs\nexactly three\nseals, with no\nspare output",
                      "because the mix\nexpires. Six stock\nunits are\navailable; two\nmust remain for",
                      "another crew.\nRecipe A uses two\nstock for two\nseals. Recipe B\nuses four stock",
                      "for three. Only\nwhole batches are\nallowed. The first\nstandard\ninspection and",
                      "this practice\norder must each be\nplanned on their\nown terms."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "b5f73d18-cc81-4e68-a312-b85fd47255f0",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "e30f1649-b6f6-42c3-ae2b-07637255c3b3",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
