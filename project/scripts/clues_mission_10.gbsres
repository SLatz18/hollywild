      "children": {
        "true": [
          {
            "id": "f388e5fc-80bc-4ebf-aa44-4fef058e9ea6",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "fe222cda-9ffa-44d0-abe6-016df4019014",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "49594f5b-8d85-4b72-ae52-8f0c356ef425",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Rivet offers\nRESERVE, holding\nspare seals for\nsudden faults, or",
                      "SHARED, pooling\norders and\npublishing the\nstock ledger. Each\ncan",
                      "work if people\nkeep the promise.\nChoose the policy\nthe crew will use",
                      "in later tests."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "73ec0cac-503b-498b-a152-db51b102f56d",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "40a9c976-c3db-4689-af2f-a92715d76588",
      "command": "EVENT_IF",
      "args": {
