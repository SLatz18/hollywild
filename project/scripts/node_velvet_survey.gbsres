                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Choose the public\nreview copy: ALL\nincludes every\nfield; COSTS",
                                        "includes repair\namount AND work\ndate; NAMES\nincludes tenant",
                                        "identities only.\nWhich copy\nverifies the\nrepair without\nexposing",
                                        "unrelated private\ndetails? Nib will\ncompare it with\nthe original",
                                        "before posting.\nSlush waits\nwithout suggesting\nthat privacy\nshould",
                                        "excuse hiding the\nprice of the work.\nThe same standard\napplies to",
                                        "either review\nprocess."
                                      ],
