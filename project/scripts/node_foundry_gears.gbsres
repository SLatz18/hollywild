                      {
                        "id": "ca239478-0861-4c63-aee1-94573bc426f8",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The gears turn\nfreely in Rivet's\ngloves. Each tooth\nhas a number\nrather than a",
                            "decorative\nsnowflake. She\nsays decorative\nsnowflakes are\nacceptable on many",
                            "things, including\nneither load teeth\nnor safety\ninstructions. Dot\ncopies the numbers",
                            "into the parts\nrecord."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
