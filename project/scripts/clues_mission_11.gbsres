        "true": [
          {
            "id": "658e0d0e-f9cc-455b-ad13-b99226da2c51",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "8dcbc210-34c3-4913-a568-f3c6d632f0a2",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "c0850aa4-1788-40d7-a38e-c295dfce07bb",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot tests the\nbucket itself\nbefore blaming the\ngauge. A certified\njug pours one unit",
                      "to its first mark\nand another unit\nto its second. The\nbucket agrees on\nboth. The open",
                      "line is visibly\nempty when the\npump is off. A\nspare gauge from a\nprivate showroom",
                      "has no test\nrecord. Slush\noffers it anyway,\nthen listens when\nDot explains that",
                      "a more expensive\nreading is not\nindependent\nevidence."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "624df07e-b706-49f1-a6a6-e021f76c24cc",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
