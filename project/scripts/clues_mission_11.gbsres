                {
                  "id": "6a4f2fae-a0f4-486f-a141-eb9d5c88961e",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which action\nfollows the\ncombined checks?\nThe bucket agrees\nwith the",
                      "certified jug, the\noff line is empty,\nand the fixed\nneedle claims",
                      "pressure. You may\ninspect the gauge\nmechanism, replace\nthe verified",
                      "bucket, or raise\npump power until\nthe display looks\nright. Dot will",
                      "record the reason\nbefore anyone\ntouches a tool."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
