                {
                  "id": "44020db9-125c-4fa1-a47a-a726b07bfeb6",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Test card: With\npump OFF, the open\nline must read\nZERO. With pump\nON, the measured",
                      "bucket should fill\nto TWO marks. A\ngauge that reads\nTWO while the pump\nis off has a stuck",
                      "needle, not secret\npressure."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
