                {
                  "id": "b5f73d18-cc81-4e68-a312-b85fd47255f0",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Test card: With\npump OFF, the open\nline must read\nZERO. With pump",
                      "ON, the measured\nbucket should fill\nto TWO marks. A\ngauge that reads",
                      "TWO while the pump\nis off has a stuck\nneedle, not secret\npressure."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
