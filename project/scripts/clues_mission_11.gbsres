                  "id": "5980f7da-f692-44e8-a8aa-2001dedb5e80",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot turns the pump\noff. The line is\nopen, the bucket\nis empty, and the\nneedle still reads",
                      "TWO. She records\nall three facts\nbefore touching\nthe screw. Rivet\nsays a neat",
                      "notebook is less\nexpensive than a\nneat explanation\nafterward."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
