                              "id": "3148741a-e9da-43f9-a733-d11e361ef8b2",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "A sample report\nsays someone saw a\nlamp but could not\ntell whether it\nwas steady or",
                                  "double. The\nreceiver must not\ninvent a clear\ncode from an\nunclear sighting.",
                                  "A written received\ncard at the post\ncan resolve the\ndoubt; if it\ncannot, the",
                                  "receiver must\ncheck in person.\nThe clerk\nremembers how much\ntrouble began when",
                                  "silence was\ntreated as\nagreement. An",
                                  "uncertain flash\ndeserves the same\nhonest caution."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
