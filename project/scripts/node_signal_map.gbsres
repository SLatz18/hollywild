                        "id": "18822ef0-6db1-44c6-a6ef-8b50087301f7",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "A Route Is a\nPerson",
                            "The courier path\non the signal map\nincludes a blank\nfor the duty",
                            "name. Dot added it\nafter noticing\nevery old map\ntreated messages\nas",
                            "if they moved\nthemselves. Moxie\nfilled her name in\nlarge letters and",
                            "left room for\nwhoever covers her\nlunch."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      }
