                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush checks the\npublic\nprotections, then\nsigns as one\nparticipant. He",
                      "has kept the old\nfault card. This\ntime, he says, if\nmy branch fails, I\nknow who to call.",
                      "Pip answers: And\nthey know you will\nanswer back."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
