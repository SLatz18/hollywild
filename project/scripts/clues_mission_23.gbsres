                {
                  "id": "2d2d37d0-f1bd-4cf2-a289-73b227074696",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Choose the first\nemphasis. WARMTH\nimproves daily\ncomfort. WORK\ninvests first in",
                      "repair shops and\nlivelihoods.\nCOMMONS invests\nfirst in shared\nplaces. All three",
                      "restore the\nnetwork and keep\nthe city open for\nfree exploration."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
