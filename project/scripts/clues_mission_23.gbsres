                },
                {
                  "id": "d2ef0bb2-e15c-425f-a736-db42536e1217",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot reads the\nprotections aloud.\nService stays\nwithin FOUR.\nFaults are logged.",
                      "Public paths stay\nopen. Homes are\nnot pledged\nagainst the repair\ndebt. Slush asks",
                      "whether these\napply to all three\nproposals. They",
                      "do. He nods and\nputs away a fourth\nproposal."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
