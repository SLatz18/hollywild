                  "id": "b81d5294-d4c8-4a90-a693-96bf49c1264d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Choose the first\nemphasis. WARMTH\nimproves daily\ncomfort. WORK",
                      "invests first in\nrepair shops and\nlivelihoods.\nCOMMONS invests\nfirst",
                      "in shared places.\nAll three restore\nthe network and\nkeep the city",
                      "open for free\nexploration."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
