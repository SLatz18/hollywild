                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Moxie pins your\nroute on the\nsorting desk. She\nstops calling the",
                      "project a rescue.\nRescue sounds like\none brave person,\nshe says. A",
                      "route needs\nsomebody to do it\nagain tomorrow.\nPip quietly\nchanges",
                      "the heading."
                    ],
