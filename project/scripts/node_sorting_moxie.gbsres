                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "The Famous Racing\nStripe",
                                        "Moxie's racing\nstripe is painted\non the inside of\nthe sled runner,",
                                        "where almost\nnobody sees it.\nShe painted it\nduring a long\nrepair. It",
                                        "reminds her the\nsled can move\nagain. She claims\nit adds speed, but",
                                        "only when properly\nmaintained."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
