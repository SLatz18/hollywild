                                  },
                                  {
                                    "id": "9b8e3e51-db4c-44dc-a293-069e485919e3",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Nib reads every\nlimit before\nanyone signs. The\npermission covers\nthe",
                                        "existing hatch and\npipe chase only.\nSlush adds his\nrepair invoice as",
                                        "a separate\nattachment. For\nonce, nobody tries\nto sell a corridor\nby",
                                        "calling it a\nlifestyle."
