                        }
                      },
                      {
                        "id": "5b34085c-34a0-4090-aaa9-9a2c542f82b6",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Velvet Lodge: mark\nthe lawful access\narea on the\nlisting."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      }
                    ],
