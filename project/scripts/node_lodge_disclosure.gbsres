                    }
                  }
                },
                {
                  "id": "323fbe27-dacc-4add-aa65-5e891225077c",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Frostwick Archive:\nidentify the\ndocument that\ngoverns the pipes."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
