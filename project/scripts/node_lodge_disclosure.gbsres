                      {
                        "id": "3ff12702-ba80-4667-ab68-38b50fb9d522",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The White Space",
                            "The disclosure\nleaves a blank\nstrip beside each\nexclusion so a",
                            "reader can ask\nquestions. Nib\nonce thought blank\nspace wasted a",
                            "selling chance.\nNow he keeps spare\npencils beside it.\nThe most",
                            "recent question is\nsimple: Who fixes\nthis if you move\naway?"
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      }
                    ],
