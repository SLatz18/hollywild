                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The disclosure\nlists walls, roof,\nand courtyard. It\nexcludes municipal\npipes and rights",
                            "of passage. A\nseparate\ninspection invoice\ncarries Slush's\nletterhead. Nib",
                            "circles EXCLUDES\nwith a pen\nexpensive enough\nto regret every\ncircle."
                          ],
