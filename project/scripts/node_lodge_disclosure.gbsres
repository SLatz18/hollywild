                                  {
                                    "id": "88d33a4d-4316-4248-a955-d00730eef64d",
                                    "command": "EVENT_TEXT",
                                    "args": {
                                      "text": [
                                        "Nib reads every\nlimit before\nanyone signs. The\npermission covers\nthe existing hatch",
                                        "and pipe chase\nonly. Slush adds\nhis repair invoice\nas a separate\nattachment. For",
                                        "once, nobody tries\nto sell a corridor\nby calling it a\nlifestyle."
                                      ],
                                      "avatarId": "",
                                      "minHeight": 4,
                                      "maxHeight": 7,
