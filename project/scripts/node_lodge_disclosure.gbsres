                    "true": [
                      {
                        "id": "233246b1-f1f4-46fd-a210-5cb669125191",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "The easement\npermits city\nworkers to cross\nthe service hall\nfor pipe",
                            "repairs. It does\nnot grant public\nuse of bedrooms or\nkitchen. The",
                            "lodge owner keeps\nthose rooms. Nib\nreads the boundary\naloud,",
                            "unusually free of\ntheatrical\ngestures."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      },
                      {
                        "id": "4f5ffdf0-c2e8-41e1-a2cd-4aa14cef0c4a",
                        "command": "EVENT_SET_VALUE",
                        "args": {
                          "variable": "44",
                          "value": {
                            "type": "number",
                            "value": 3
                          }
                        }
                      },
                      {
                        "id": "0091f705-b59f-41da-a161-9ca967f47e28",
                        "command": "EVENT_TEXT",
                        "args": {
                          "text": [
                            "Velvet Lodge: mark\nthe lawful access\narea on the\nlisting."
                          ],
                          "avatarId": "",
                          "minHeight": 4,
                          "maxHeight": 7,
                          "position": "bottom",
                          "closeWhen": "key",
                          "closeButton": "a"
                        }
                      }
                    ],
                    "false": [
                      {
