                    }
                  }
                },
                {
                  "id": "249c0bdf-d5ec-4633-a0cb-3165b709649d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Frostwick Archive:\nidentify the\ndocument that\ngoverns the pipes."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
