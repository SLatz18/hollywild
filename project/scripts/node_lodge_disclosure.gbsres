                        "children": {
                          "true": [
                            {
                              "id": "0a786c88-e485-4ffd-a542-c1659bb30322",
                              "command": "EVENT_TEXT",
                              "args": {
                                "text": [
                                  "Which instruction\nbelongs in the\ncrew access\nnotice? Keep the",
                                  "service right\neffective without\nturning it into a\nclaim over private",
                                  "rooms. The tenant\nwill receive the\nsame notice as the\nbuilders. Nib",
                                  "wants her to know\nexactly where\nstrangers will\nwalk, not merely\nbe",
                                  "reassured that\neveryone means\nwell and carries\nclean boots."
                                ],
                                "avatarId": "",
                                "minHeight": 4,
                                "maxHeight": 7,
                                "position": "bottom",
                                "closeWhen": "key",
                                "closeButton": "a"
                              }
