                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "86ba594e-ed92-4063-ad02-fc5d69dd39db",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "After comparing\nthe disclosure\nwith the\ninspection\ninvoice, who",
                      "retains the pipe\nnetwork?"
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "ec781ef3-b1a3-4407-af1e-dc0d9d29f78c",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "f0f28a6b-ed05-4648-a3aa-4b271358089a",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
