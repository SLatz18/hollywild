      },
      "children": {
        "true": [
          {
            "id": "bbbfdce7-609f-4374-ab28-336b6a510503",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "e29174da-ddd7-4665-a120-aeefa020a373",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "a98ab68e-7d62-40e2-a616-1c960af7796e",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush: You have\ndiscovered a\ndistinction.\nCongratulations. I\ndiscovered twelve",
                      "leaking roofs\nwhile the council\ndiscovered lunch.\nBring me a\nworkable network",
                      "plan, and I will\ndiscuss my\ninvoice. Bring me",
                      "a slogan, and I\nwill charge for\nthe umbrella."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "85cadeda-17e6-464e-a071-e0b56c191517",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    }
