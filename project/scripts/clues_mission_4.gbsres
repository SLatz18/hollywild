                  "id": "b77ef86d-b2db-4646-a964-f2f59b9b090e",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "59202e33-4f4b-46e6-a6c1-1a5c8597c47e",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "After comparing\nthe disclosure\nwith the\ninspection\ninvoice, who",
                      "retains the pipe\nnetwork?"
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "fe13f4d0-8c8a-4d44-abaf-cb3b11d9be8f",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "f6ba6a79-d0cc-4f2c-a63a-9bae58adc4b4",
      "command": "EVENT_IF",
      "args": {
        "condition": {
