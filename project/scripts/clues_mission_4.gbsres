      "children": {
        "true": [
          {
            "id": "baaaa9fb-67b3-4c61-a85c-c4e5b37e485c",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "693e2a69-b9a6-4522-ae15-9418b9464027",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "2b3912e2-d96a-4f96-a9cf-62f1e9526f32",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Slush: You have\ndiscovered a\ndistinction.\nCongratulations. I",
                      "discovered twelve\nleaking roofs\nwhile the council\ndiscovered lunch.",
                      "Bring me a\nworkable network\nplan, and I will\ndiscuss my\ninvoice.",
                      "Bring me a slogan,\nand I will charge\nfor the umbrella."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "8cd41a5f-4048-43fe-a5f1-257bf7166e52",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
