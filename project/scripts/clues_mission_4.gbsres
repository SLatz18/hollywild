      },
      "children": {
        "true": [
          {
            "id": "445175ac-52ee-475a-ae11-e6fb4801fdc3",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "7d7c3056-882a-48ac-a231-c5c866e056f8",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "1be389cc-f2a8-4121-a28f-a95c2ff8739a",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The disclosure\nlists walls, roof,\nand courtyard. It\nexcludes",
                      "municipal pipes\nand rights of\npassage. A\nseparate\ninspection invoice",
                      "carries Slush's\nletterhead. Nib\ncircles EXCLUDES\nwith a pen",
                      "expensive enough\nto regret every\ncircle."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "cf9c9c90-5893-434e-a89e-b9a6cf6ebbd6",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
