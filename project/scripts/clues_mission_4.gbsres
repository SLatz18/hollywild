        }
      },
      "children": {
        "true": [
          {
            "id": "009ac6cd-5551-4e9a-ab6f-759250becc46",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "1cfde289-8eeb-416b-aed0-e67f8ccb315c",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "5aea87e5-c911-453e-a294-b42e1242bb6e",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which statement\ncan stay on the\ncorrected listing?\nConsider what the\ninvoice proves was",
                      "done and what the\nsale schedule\nactually includes.\nSlush will receive\nthe revision too.",
                      "Nib wants to\nacknowledge real\nrepairs without\nturning an\ninspected public",
                      "pipe into private\nproperty, or\npretending a paid\ninspection was\nnever useful work."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "a46ec415-8fc4-4815-af03-f983b48979b9",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "c88fb640-7e09-48ac-acad-f8629a9af0ec",
      "command": "EVENT_IF",
      "args": {
        "condition": {
