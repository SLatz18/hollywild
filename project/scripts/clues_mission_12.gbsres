        "true": [
          {
            "id": "37d01f73-e777-42b9-a927-50300cc6a39b",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "b6be141a-04f1-43aa-a928-3e6616c9f671",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "27a9c440-d8ef-498c-a285-33d0c38df4ad",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The lock card adds\na condition to the\nprocess sheets:\nthe crew must\ndisconnect power",
                      "before opening the\nregulator cover.\nThe spring is\nfitted with the\ncover open. The",
                      "limit is set after\nthe spring is\nsecured. The cover\nis then shut\nbefore power",
                      "returns for\ntesting. Dot\narranges blank\ncards on the desk\nand asks the",
                      "inspector to keep\nhis silver ruler\naway from all of\nthem."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "4d33c108-26f1-4567-a66d-4c21611f45aa",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
