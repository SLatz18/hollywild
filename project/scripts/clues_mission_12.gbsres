    {
      "id": "710af3a4-ea55-4261-a11d-f0ab4441efa6",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
