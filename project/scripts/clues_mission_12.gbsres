                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The inspector\nwatches three\ncycles, including\na loss of power.\nThe valve closes",
                      "each time. He\nsigns a plain\nsheet. Slush\nwanted a\ncertificate",
                      "suitable for a\nwall. Rivet wants\na record suitable",
                      "for the next\nperson at the\nbench."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
