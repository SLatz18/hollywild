                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The inspector asks\nwhat happens if\none seal fails the\ntest. Rivet points\nto the supply",
                      "promise you made,\nthen asks Dot to\nexplain how the\nreplacement\nreaches the bench."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
