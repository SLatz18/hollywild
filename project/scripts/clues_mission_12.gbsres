                  "id": "f20ace90-2b50-43ef-a753-8e9fe292272c",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "The inspector asks\nwhat happens if\none seal fails the\ntest. Rivet",
                      "points to the\nsupply promise you\nmade, then asks\nDot to explain how",
                      "the replacement\nreaches the bench."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
