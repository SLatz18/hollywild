                {
                  "id": "624df07e-b706-49f1-a6a6-e021f76c24cc",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Process cards: FIT\nspring before\nenergizing. SET\nlimit after",
                      "fitting. TEST with\npower last. Card\norder is not a\nsuggestion. The",
                      "inspector asks if\nthe wooden spoon\nis approved\nequipment. Rivet\nsays",
                      "it is approved for\nmoving his ruler."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
