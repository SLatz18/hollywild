  "script": [
    {
      "id": "062033ef-27a7-46fe-a5a0-b1846ca5fddf",
      "command": "EVENT_TEXT",
      "args": {
        "text": [
          "Clues: The Pages\nThat Stayed Put"
        ],
        "avatarId": "",
        "minHeight": 4,
        "maxHeight": 7,
        "position": "bottom",
        "closeWhen": "key",
        "closeButton": "a"
      }
    },
    {
      "id": "177dcb66-0847-4f36-a30d-1fa5d26fa482",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "eq",
