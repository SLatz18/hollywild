                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Aurora Core: read\nthe branch demand\ncard at the\nbypass."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
