                  "args": {}
                },
                {
                  "id": "ccdef7f0-2bf0-433c-afc6-3b3b75e4e56d",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Dot: The bell wire\ngoes to this\nantenna. Its brass\ntag says SEND",
                      "NORTH. The vane\npoints toward\nAurora when its\narrow meets the\nnotch.",
                      "Wind moved the\nvane, but the\nnotch is still cut\ninto the stone."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "1f959ea5-3380-4247-aa92-2e3d395ba013",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "fc8d811c-b38f-4001-a46a-39dad18401ec",
      "command": "EVENT_IF",
      "args": {
        "condition": {
          "type": "gt",
          "valueA": {
            "type": "variable",
            "value": "44"
          },
          "valueB": {
            "type": "number",
            "value": 1
          }
        }
      },
      "children": {
        "true": [
          {
            "id": "135b5a13-3abd-4fa6-a894-c3f73f5f3904",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "2bea25c2-5d77-4965-a536-3e34648ff982",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "cdf6d548-42f5-46d4-a987-4b96938a7934",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Three entries\nsurvive in the\nwatch log. At\nseven, the roof\nsent its",
                      "alarm. At eight,\nAurora recorded\nthat alarm. At\nnine, Aurora",
                      "attempted a reply,\nbut no roof\nreceipt was\nlogged. Dot points\nout",
                      "that the first two\nentries show a\nsuccessful outward\npath. A later",
                      "problem may affect\nthe return path\nwithout erasing\nthe earlier",
                      "delivery. The\nwatch keeper wants\nhis crew cleared\nof a false",
                      "accusation."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "58a1d08d-375c-44d1-a6b1-c7e68dc78748",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
