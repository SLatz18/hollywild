      "children": {
        "true": [
          {
            "id": "1deba7a7-14b8-4a2d-a66d-42aad22d4081",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "6c587aae-64bd-4609-a5e7-52f82ecd4ad1",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "8adb5f17-a1b9-4dc8-a8a4-fd2eff95b96a",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: We received\nthe bell. We sent\na reply through\nthe same wire\nafter the relay",
                      "froze. That reply\nnever left the\nbuilding. Two\nmessages, one\nwire, and no other",
                      "way to ask for\nhelp. Dot shuts\nher notebook very\nsoftly."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "7cd5e27f-ebab-4f1c-ae1d-42dd31e50e9c",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
