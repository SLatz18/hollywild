                  "args": {}
                },
                {
                  "id": "e01e4897-0c50-4313-a463-51fca22ba371",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Align the vane for\nthe signal\ndestination named\non the antenna\ntag. Which",
                      "direction matches\nits fixed stone\nmark?"
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
