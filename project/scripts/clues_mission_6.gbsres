          }
        }
      },
      "children": {
        "true": [
          {
            "id": "9c177595-c100-4bdc-a343-b9879d95edb9",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "ba07dc29-959c-4957-a9f0-e8a89a6556aa",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "c648fced-3de9-454a-a462-511fbefda177",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "A waxed parcel\nholds the watch\nlog, kept dry\nbeneath the chest\nlid. The alarm was",
                      "sent. The\nacknowledgment\nnever came back.\nDot reads this\ntwice, then asks",
                      "you to carry the\noriginal while she\nkeeps an exact\ncopy."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "b145b55e-99d8-417d-ae8f-71e766810b08",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
