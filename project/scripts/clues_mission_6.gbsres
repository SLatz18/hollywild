      "children": {
        "true": [
          {
            "id": "6fd558a8-53f4-43d9-a5a3-4be543bd01f1",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "2e01f7c2-ca8a-4ea1-a48d-fb641e4ae5b7",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "1a2ab657-9715-4195-aed5-5bfec9f5e2ed",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which leg needs\ninvestigation\nfirst: the alarm\nleaving the roof,\nthe",
                      "alarm reaching\nAurora, or the\nattempted reply\nreturning? Use the",
                      "separate entries\nrather than\nassuming the whole\nsystem either\nworked",
                      "or failed. The\nwatch keeper has\nwaited years to\nhear an answer\nthat",
                      "distinguishes what\nhis crew did from\nwhat the machinery\ncould",
                      "confirm."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "af424e1e-0dda-4bfc-a5e4-fb79009d5df2",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "bc4e3d8e-727f-4833-a207-0fefc769645e",
      "command": "EVENT_IF",
      "args": {
