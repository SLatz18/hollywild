      },
      "children": {
        "true": [
          {
            "id": "c98edf2e-6a3d-497b-ad82-4221cf29207e",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "58e0977c-14c2-4596-ac1d-6887d24d46b2",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "c1332fc2-669b-41a2-a55d-c757e464ace1",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Which leg needs\ninvestigation\nfirst: the alarm\nleaving the roof,\nthe alarm reaching",
                      "Aurora, or the\nattempted reply\nreturning? Use the\nseparate entries\nrather than",
                      "assuming the whole\nsystem either\nworked or failed.\nThe watch keeper\nhas waited years",
                      "to hear an answer\nthat distinguishes\nwhat his crew did",
                      "from what the\nmachinery could\nconfirm."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "ea0d2758-c0ff-48c3-afa8-121c4d29e4b9",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
    },
    {
      "id": "5d4b056e-f961-43c8-aeea-7d61aa1b9323",
