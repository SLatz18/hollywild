      "children": {
        "true": [
          {
            "id": "bfbbca50-664f-42ee-abc4-78a56c5ee10c",
            "command": "EVENT_GROUP",
            "args": {},
            "children": {
              "true": [
                {
                  "id": "c7a2f4d6-19df-403a-aab6-86314a23f51e",
                  "command": "EVENT_HIDE_SPRITES",
                  "args": {}
                },
                {
                  "id": "5da2b139-248f-41d6-a62e-376df5dac585",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "A waxed parcel\nholds the watch\nlog, kept dry\nbeneath the chest\nlid.",
                      "The alarm was\nsent. The\nacknowledgment\nnever came back.\nDot reads",
                      "this twice, then\nasks you to carry\nthe original while\nshe keeps an",
                      "exact copy."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "73d37c0c-1259-4a32-a6c1-10798d8c6682",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
          }
        ],
        "false": []
      }
