                  "args": {}
                },
                {
                  "id": "920329cb-096f-427e-afa3-672fba4c371a",
                  "command": "EVENT_TEXT",
                  "args": {
                    "text": [
                      "Clerk: We received\nthe bell. We sent\na reply through\nthe same wire",
                      "after the relay\nfroze. That reply\nnever left the\nbuilding. Two",
                      "messages, one\nwire, and no other\nway to ask for\nhelp. Dot shuts\nher",
                      "notebook very\nsoftly."
                    ],
                    "avatarId": "",
                    "minHeight": 4,
                    "maxHeight": 7,
                    "position": "bottom",
                    "closeWhen": "key",
                    "closeButton": "a"
                  }
                },
                {
                  "id": "9b2795b0-86a3-4a07-a5b7-5bbbb25ecfdd",
                  "command": "EVENT_SHOW_SPRITES",
                  "args": {}
                }
              ]
            }
